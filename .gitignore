# ---- 环境与依赖（可重建）----
.venv/
__pycache__/
*.pyc
dsh-plugin/node_modules/

# ---- 计算产物（大且可再生；只留代码不留数据）----
server/outputs/

# ---- 版权资产：POTCAR 赝势库严禁上传 GitHub ----
potcars/

# ---- pytest 运行临时目录 ----
.pytest_tmp*/
.pytest_cache/
