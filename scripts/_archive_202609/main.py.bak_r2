# ─────────────────────────── 建模辅助 ───────────────────────────

def _estimate_lattice(composition: Composition) -> Lattice:
    """按元素原子体积之和估算简单立方初始晶格（粗略，仅作初始猜测）。"""
    total_volume = sum(
        _ATOMIC_VOLUME.get(el.symbol, _DEFAULT_VOLUME) * int(comp)
        for el, comp in composition.items()
    )
    a = round(total_volume ** (1.0 / 3.0), 4)
    return Lattice.cubic(a)


def _fcc_basis() -> list[list[float]]:
    return [[0.0, 0.0, 0.0], [0.5, 0.5, 0.0], [0.5, 0.0, 0.5], [0.0, 0.5, 0.5]]


def _bcc_basis() -> list[list[float]]:
    return [[0.0, 0.0, 0.0], [0.5, 0.5, 0.5]]


def _structure_summary(structure: Structure) -> str:
    """生成结构摘要文本（预览用）。"""
    lines = [
        f"化学式（约化）: {structure.composition.reduced_formula}",
        f"化学式（原胞）: {structure.composition.formula}",
        f"原子总数: {structure.num_sites}",
        f"晶格参数 a,b,c (Å): {structure.lattice.abc[0]:.4f}, {structure.lattice.abc[1]:.4f}, {structure.lattice.abc[2]:.4f}",
        f"晶格角度 α,β,γ (°): {structure.lattice.angles[0]:.2f}, {structure.lattice.angles[1]:.2f}, {structure.lattice.angles[2]:.2f}",
        f"晶胞体积 (Å³): {structure.volume:.4f}",
        f"密度 (g/cm³): {structure.density:.4f}",
        "元素占比: "
        + ", ".join(
            f"{el.symbol}×{int(structure.composition[el])}" for el in structure.composition
        ),
    ]
    return "\n".join(lines)


def _to_vasp5_poscar(structure: Structure) -> str:
    """构造 VASP5 标准分组 POSCAR（按元素分组物种行与计数行）。

    注意：pymatgen 2026 新版 Poscar.get_str() 逐原子输出物种行
    （Na Cl Na Cl ...），不符合 VASP 要求，故手动构造。
    """
    from collections import defaultdict

    comp = structure.composition
    els = [el.symbol for el in comp.elements]
    counts = [int(comp[el]) for el in els]

    by_el: dict[str, list] = defaultdict(list)
    for site in structure:
        by_el[site.species_string].append(site.frac_coords)

    lines = [
        structure.composition.reduced_formula,
        "1.0",
    ]
    for row in structure.lattice.matrix:
        lines.append(" ".join(f"{x:.10f}" for x in row))
    lines.append(" ".join(els))
    lines.append(" ".join(str(c) for c in counts))
    lines.append("direct")
    for el in els:
        for fc in by_el[el]:
            lines.append(" ".join(f"{x:.10f}" for x in fc) + f" {el}")
    return "\n".join(lines) + "\n"


def _elements_of(composition: Composition) -> list[str]:
    return [el.symbol for el in composition.elements]


def _check_ratio(composition: Composition, expected: dict[str, int], proto: str) -> Optional[str]:
    """校验组成是否符合原型化学计量比。"""
    actual = {el.symbol: int(composition[el]) for el in composition.elements}
    expected_str = " ".join(f"{k}{v}" for k, v in expected.items())
    if sorted(actual.values()) != sorted(expected.values()):
        return (
            f"错误：原型 {proto} 要求化学计量比 {expected_str}，"
            f"实际为 {' '.join(f'{k}{v}' for k, v in actual.items())}"
        )
    return None


def _build_prototype(
    prototype: str, composition: Composition, lattice_params: Optional[str]
) -> tuple[Structure, str]:
    """按原型模板构建真实晶体结构。返回 (structure, 说明文本)。"""
    els = _elements_of(composition)
    cubic_a: Optional[float] = None
    lattice: Lattice
    note_lines: list[str] = []

    # 解析用户提供的晶格参数
    if lattice_params:
        vals = [float(x) for x in lattice_params.replace(" ", "").split(",")]
        if len(vals) == 6:
            lattice = Lattice.from_parameters(*vals)
            note_lines.append(f"使用用户提供的晶格参数: {lattice_params}")
        else:
            raise ValueError("lattice_parameters 需为 6 个数值（a,b,c,alpha,beta,gamma）")
    else:
        # 估算晶格：按原型经验公式（粗略，建议从文献核实））
        r = {el: float(Element(el).atomic_radius or 1.0) for el in els}
        if prototype in ("rocksalt", "zincblende"):
            cubic_a = round(2.0 * (r[els[0]] + r[els[1]]), 3)
        elif prototype == "perovskite":
            cubic_a = round(2.0 * (r[els[0]] + r[els[2]]), 3)
        elif prototype == "fluorite":
            cubic_a = round(2.0 * (r[els[0]] + r[els[1]]), 3)
        elif prototype in ("bcc", "fcc"):
            cubic_a = round(2.0 * r[els[0]], 3)
        elif prototype == "hcp":
            cubic_a = round(2.0 * r[els[0]], 3)
        else:  # pragma: no cover
            raise ValueError(f"未知原型: {prototype}")
        lattice = Lattice.cubic(cubic_a) if prototype != "hcp" else Lattice.hexagonal(cubic_a, round(1.633 * cubic_a, 3))
        note_lines.append(f"晶格参数按元素半径估算（{prototype} 经验公式）: a={cubic_a} Å，建议从文献核实")

    species: list[str] = []
    coords: list[list[float]] = []
    bases: list[list[float]] = [[0.0, 0.0, 0.0]]

    if prototype == "rocksalt":
        err = _check_ratio(composition, {els[0]: 1, els[1]: 1}, "rocksalt")
        if err:
            raise ValueError(err)
        bases = _fcc_basis()
        for b in bases:
            species.append(els[0])
            coords.append(b)
            species.append(els[1])
            coords.append([b[0] + 0.5, b[1] + 0.5, b[2] + 0.5])
        note_lines.append(f"岩盐结构（{els[0]} 在 FCC 位点，{els[1]} 在 (0.5,0.5,0.5) 偏移位点）")
    elif prototype == "zincblende":
        err = _check_ratio(composition, {els[0]: 1, els[1]: 1}, "zincblende")
        if err:
            raise ValueError(err)
        bases = _fcc_basis()
        for b in bases:
            species.append(els[0])
            coords.append(b)
            species.append(els[1])
            coords.append([b[0] + 0.25, b[1] + 0.25, b[2] + 0.25])
        note_lines.append(f"闪锌矿结构（{els[0]} FCC + {els[1]} (0.25,0.25,0.25) 偏移）")
    elif prototype == "perovskite":
        err = _check_ratio(composition, {els[0]: 1, els[1]: 1, els[2]: 3}, "perovskite")
        if err:
            raise ValueError(err)
        species = [els[0], els[1], els[2], els[2], els[2]]
        coords = [
            [0.0, 0.0, 0.0],
            [0.5, 0.5, 0.5],
            [0.5, 0.5, 0.0],
            [0.5, 0.0, 0.5],
            [0.0, 0.5, 0.5],
        ]
        note_lines.append(f"理想钙钛矿结构（A={els[0]} 角位，B={els[1]} 体心，O={els[2]} 面心；未考虑 tilting）")
    elif prototype == "fluorite":
        err = _check_ratio(composition, {els[0]: 1, els[1]: 2}, "fluorite")
        if err:
            raise ValueError(err)
        bases = _fcc_basis()
        for b in bases:
            species.append(els[0])
            coords.append(b)
            species.append(els[1])
            coords.append([b[0] + 0.25, b[1] + 0.25, b[2] + 0.25])
            species.append(els[1])
            coords.append([b[0] + 0.75, b[1] + 0.75, b[2] + 0.75])
        note_lines.append(f"萤石结构（{els[0]} FCC + {els[1]} 在 (0.25,0.25,0.25)/(0.75,0.75,0.75)）")
    elif prototype == "bcc":
        if len(els) != 1:
            raise ValueError(f"错误：bcc 原型要求单一元素，实际为 {els}")
        bases = _bcc_basis()
        for b in bases:
            species.append(els[0])
            coords.append(b)
        note_lines.append("体心立方（bcc）")
    elif prototype == "fcc":
        if len(els) != 1:
            raise ValueError(f"错误：fcc 原型要求单一元素，实际为 {els}")
        bases = _fcc_basis()
        for b in bases:
            species.append(els[0])
            coords.append(b)
        note_lines.append("面心立方（fcc）")
    elif prototype == "hcp":
        if len(els) != 1:
            raise ValueError(f"错误：hcp 原型要求单一元素，实际为 {els}")
        species = [els[0], els[0]]
        coords = [[0.0, 0.0, 0.0], [1.0 / 3.0, 2.0 / 3.0, 0.5]]
        note_lines.append("六方密堆（hcp），c/a=1.633（理想值）")
    else:  # pragma: no cover
        raise ValueError(f"未知原型: {prototype}")

    structure = Structure(lattice, species, coords, coords_are_cartesian=False)
    return structure, "\n".join(note_lines)


# ─────────────────────────── MCP 工具 ───────────────────────────

@mcp.tool()
def build_structure(
    composition: str,
    lattice_parameters: Optional[str] = None,
    spacegroup: Optional[int] = None,
    prototype: Optional[str] = None,
    save: bool = True,
    project: Optional[str] = None,
) -> str:
    """由化学式生成晶体结构。

    Args:
        composition: 化学式，如 "Li2ZrCl6"、"NaCl"、"Fe2O3"。
        lattice_parameters: 可选，格式 "a,b,c,alpha,beta,gamma"
            （a/b/c 单位为 Å，角度为度），如 "10.2,10.2,10.2,90,90,90"；
            缺省时按原型经验公式或原子体积估算。
        spacegroup: 可选，空间群编号（1-230）；M1 仅做合法性校验，
            Wyckoff 位点级建模在后续里程碑实现。
        prototype: 可选，原型模板：rocksalt（岩盐 AB）/ zincblende（闪锌矿 AB）/
            perovskite（钙钛矿 ABO3）/ fluorite（萤石 AB2）/ bcc / fcc / hcp。
        save: 是否将 POSCAR 保存到 outputs 目录（默认 True）。
        project: 可选项目名——产物保存到 outputs/<project>/structures/。

    Returns:
        结构摘要 + 建模说明 + POSCAR 文本（含保存路径）。
    """
    # 1. 解析化学式
    try:
        comp = Composition(composition)
    except Exception as e:  # noqa: BLE001
        return f"错误：无法解析化学式 '{composition}'（{e}）"
    comp = comp.reduced_composition
    if comp.num_atoms == 0:
        return "错误：化学式不包含任何原子"

    # 2. 构建结构
    structure: Structure
    proto_note = ""
    try:
        if prototype:
            prototype = prototype.strip().lower()
            structure, proto_note = _build_prototype(prototype, comp, lattice_parameters)
        else:
            # 初始粗略结构（M0 逻辑）：每元素一个位点
            if lattice_parameters:
                vals = [float(x) for x in lattice_parameters.replace(" ", "").split(",")]
                if len(vals) != 6:
                    return "错误：lattice_parameters 需为 6 个数值（a,b,c,alpha,beta,gamma）"
                lattice = Lattice.from_parameters(*vals)
            else:
                lattice = _estimate_lattice(comp)
            species: list[str] = []
            coords: list[list[float]] = []
            n_el = len(comp.elements)
            for i, el in enumerate(comp.elements):
                species.append(el.symbol)
                t = 0.125 + 0.25 * i / max(n_el - 1, 1)
                coords.append([t, t, t])
            structure = Structure(lattice, species, coords, coords_are_cartesian=False)
            proto_note = "初始粗略结构（每元素 1 个位点），正式建模请用 prototype 参数"
    except ValueError as e:
        return f"错误：{e}"
    except Exception as e:  # noqa: BLE001
        return f"错误：结构构建失败（{e}）"

    # 3. 空间群校验（仅合法性）
    sg_note = "未指定"
    if spacegroup is not None:
        try:
            sg = SpaceGroup.from_int_number(spacegroup)
            sg_note = f"{spacegroup}（{sg.symbol}）— 仅校验，未做 Wyckoff 填充"
        except Exception as e:  # noqa: BLE001
            return f"错误：空间群编号 {spacegroup} 不合法（{e}）"

    poscar_str = _to_vasp5_poscar(structure)

    # 4. 保存
    save_note = ""
    if save:
        fpath = os.path.join(_out_dir(project, "structure"), f"{comp.reduced_formula}_{int(time.time())}.vasp")
        with open(fpath, "w", encoding="utf-8") as f:
            f.write(poscar_str)
        save_note = f"\n已保存: {fpath}"

    return (
        f"请求化学式: {comp.reduced_formula}（约化）\n"
        f"建模方式: {proto_note}\n\n"
        f"## 结构摘要\n{_structure_summary(structure)}\n"
        f"空间群: {sg_note}\n"
        f"## POSCAR\n```\n{poscar_str}\n```{save_note}"
    )


@mcp.tool()
def parse_poscar(poscar_text: str) -> str:
    """解析 POSCAR 文本，返回结构摘要。

    Args:
        poscar_text: POSCAR 文件内容（多行文本）。

    Returns:
        结构摘要（晶格、元素、原子数、密度等）。
    """
    try:
        structure = Poscar.from_str(poscar_text).structure
    except Exception as e:  # noqa: BLE001
        return f"错误：POSCAR 解析失败（{e}）"
    return f"## 结构摘要\n{_structure_summary(structure)}"


@mcp.tool()
def visualize_structure(poscar_text: str, mode: str = "html", save: bool = True, project: Optional[str] = None) -> str:
    """渲染晶体结构的 3D 可视化。

    Args:
        poscar_text: POSCAR 文件内容（多行文本）。
        mode: 输出模式:
            "html" — plotly 交互式 3D（浏览器打开可旋转/缩放/悬停查看原子，对标 ASE GUI 体验；默认）
            "png"  — matplotlib 静态球棍图（VESTA 风格配色）
            "cif"  — 导出 CIF 文件（VESTA / OVITO 等软件可直接打开，专业渲染）
        save: 是否保存到 outputs 目录（默认 True）。
        project: 可选项目名——产物保存到 outputs/<project>/structures/。

    Returns:
        文件路径 + 图内容说明。
    """
    try:
        structure = Poscar.from_str(poscar_text).structure
    except Exception as e:  # noqa: BLE001
        return f"错误：POSCAR 解析失败（{e}）"

    cart = structure.cart_coords
    species = [site.species_string for site in structure]
    radii = {el: float(Element(el).atomic_radius or 0.8) for el in set(species)}
    colors = {el: _JMOL_COLORS.get(el, _DEFAULT_COLOR) for el in set(species)}

    # 键判定：距离 < 原子半径和 × 1.2
    cov = {el: radii[el] for el in set(species)}
    bonds: list[tuple[int, int]] = []
    n = len(cart)
    for i in range(n):
        for j in range(i + 1, n):
            d = math.sqrt(sum((cart[i][k] - cart[j][k]) ** 2 for k in range(3)))
            if d < 1.2 * (cov[species[i]] + cov[species[j]]):
                bonds.append((i, j))

    os.makedirs(_OUTPUTS_DIR, exist_ok=True)
    formula = structure.composition.reduced_formula

    if mode == "cif":
        fname = f"{formula}_{int(time.time())}.cif"
        fpath = os.path.join(_out_dir(project, "structure"), fname)
        structure.to(fmt="cif", filename=fpath)
        return (
            f"CIF 文件已保存: {fpath}\n"
            f"（可用 VESTA / OVITO / VMD 打开做专业渲染；原子数 {n}，键数 {len(bonds)}）"
        )

    if mode == "png":
        return _render_matplotlib(structure, cart, species, radii, bonds, save, project)

    if mode != "html":
        return f"错误：不支持的 mode '{mode}'，可选: html / png / cif"

    # ── plotly 交互式 3D ──
    import plotly.graph_objects as go  # noqa: PLC0415

    fig = go.Figure()
    fig.update_layout(
        title=f"{formula} — 3D 结构（{n} 原子）",
        scene=dict(
            xaxis_title="x (Å)", yaxis_title="y (Å)", zaxis_title="z (Å)",
            aspectmode="data",
        ),
        margin=dict(l=0, r=0, t=40, b=0),
        showlegend=True,
    )

    # 晶胞盒（12 条棱）
    lattice = structure.lattice
    corners = [lattice.get_cartesian_coords([i, j, k]) for i in (0, 1) for j in (0, 1) for k in (0, 1)]
    edges = []
    for i in range(8):
        for j in range(i + 1, 8):
            nz = sum(1 for k in range(3) if abs(corners[i][k] - corners[j][k]) > 1e-6)
            if nz == 1:
                edges.append((i, j))
    for i, j in edges:
        fig.add_trace(go.Scatter3d(
            x=[corners[i][0], corners[j][0]],
            y=[corners[i][1], corners[j][1]],
            z=[corners[i][2], corners[j][2]],
            mode="lines", line=dict(color="gray", width=2),
            hoverinfo="skip", showlegend=False,
        ))

    # 键
    for i, j in bonds:
        fig.add_trace(go.Scatter3d(
            x=[cart[i][0], cart[j][0]],
            y=[cart[i][1], cart[j][1]],
            z=[cart[i][2], cart[j][2]],
            mode="lines", line=dict(color="rgba(120,120,120,0.8)", width=4),
            hoverinfo="skip", showlegend=False,
        ))

    # 原子球（每种元素一条 trace，便于图例）
    for el in sorted(set(species)):
        idxs = [i for i, s in enumerate(species) if s == el]
        rgb = colors[el]
        color_str = f"rgb({int(rgb[0]*255)},{int(rgb[1]*255)},{int(rgb[2]*255)})"
        fig.add_trace(go.Scatter3d(
            x=[cart[i][0] for i in idxs],
            y=[cart[i][1] for i in idxs],
            z=[cart[i][2] for i in idxs],
            mode="markers",
            name=f"{el} (r={radii[el]:.2f} Å)",
            marker=dict(
                size=radii[el] * 9, color=color_str,
                opacity=0.9, line=dict(color="black", width=0.5),
            ),
            text=[f"{el} ({cart[i][0]:.2f}, {cart[i][1]:.2f}, {cart[i][2]:.2f})" for i in idxs],
            hoverinfo="text",
        ))

    fname = f"{formula}_{int(time.time())}.html"
    fpath = os.path.join(_out_dir(project, "structure"), fname)
    fig.write_html(fpath, include_plotlyjs=True)
    return (
        f"交互式 3D 图已保存: {fpath}\n"
        f"用浏览器打开可旋转/缩放/悬停查看原子（plotly，自包含无外部依赖）\n"
        f"原子数: {n}，键数（原子半径和×1.2 判据）: {len(bonds)}，元素: {', '.join(sorted(set(species)))}"
    )


def _render_matplotlib(
    structure: Structure,
    cart,
    species: list[str],
    radii: dict[str, float],
    bonds: list[tuple[int, int]],
    save: bool,
    project: Optional[str] = None,
) -> str:
    """matplotlib 静态球棍图（VESTA 风格配色）。"""
    n = len(cart)
    lattice = structure.lattice
    corners = [lattice.get_cartesian_coords([i, j, k]) for i in (0, 1) for j in (0, 1) for k in (0, 1)]

    fig = plt.figure(figsize=(8, 8))
    ax = fig.add_subplot(111, projection="3d")

    edges = []
    for i in range(8):
        for j in range(i + 1, 8):
            nz = sum(1 for k in range(3) if abs(corners[i][k] - corners[j][k]) > 1e-6)
            if nz == 1:
                edges.append((i, j))
    for i, j in edges:
        ax.plot(
            [corners[i][0], corners[j][0]],
            [corners[i][1], corners[j][1]],
            [corners[i][2], corners[j][2]],
            color="gray", linewidth=0.8, alpha=0.6,
        )

    for i, j in bonds:
        ax.plot(
            [cart[i][0], cart[j][0]],
            [cart[i][1], cart[j][1]],
            [cart[i][2], cart[j][2]],
            color="0.5", linewidth=1.2,
        )

    for idx, (el, pos) in enumerate(zip(species, cart)):
        color = _JMOL_COLORS.get(el, _DEFAULT_COLOR)
        r = radii[el] * 0.6
        ax.scatter(
            pos[0], pos[1], pos[2],
            s=(r * 2 * 80) ** 2, color=color, alpha=0.9, edgecolors="black", linewidths=0.4,
        )

    ax.set_xlabel("x (Å)")
    ax.set_ylabel("y (Å)")
    ax.set_zlabel("z (Å)")
    ax.set_box_aspect((1, 1, 1))
    legend_handles = []
    legend_labels = []
    seen = set()
    for el in species:
        if el not in seen:
            seen.add(el)
            legend_handles.append(plt.Line2D([0], [0], marker="o", color="w",
                                             markerfacecolor=_JMOL_COLORS.get(el, _DEFAULT_COLOR),
                                             markersize=10))
            legend_labels.append(f"{el} (r={radii[el]:.2f} Å)")
    ax.legend(legend_handles, legend_labels, loc="upper left", bbox_to_anchor=(1.02, 1.0))

    if save:
        fname = f"struct_{structure.composition.reduced_formula}_{int(time.time())}.png"
        fpath = os.path.join(_out_dir(project, "structure"), fname)
        plt.savefig(fpath, dpi=120, bbox_inches="tight")
        plt.close(fig)
        return (
            f"静态 3D 图已保存: {fpath}\n"
            f"原子数: {n}，键数（原子半径和×1.2 判据）: {len(bonds)}，元素: {', '.join(sorted(set(species)))}"
        )
    plt.close(fig)
    return f"渲染完成（未保存）: 原子数 {n}，键数 {len(bonds)}"


@mcp.tool()
def generate_vasp_inputs(
    poscar_text: str,
    calc_type: str = "relax",
    encut: Optional[int] = None,
    kpoint_density: Optional[float] = None,
    ismear: Optional[int] = None,
    save: bool = True,
) -> str:
    """生成 VASP 输入文件（INCAR + KPOINTS + POTCAR 拼接脚本）。

    Args:
        poscar_text: POSCAR 文件内容（多行文本，作为结构输入）。
        calc_type: 计算类型: relax / static / bands / dos / elastic。
        encut: 平面波截断能 (eV)；缺省按体系给建议值。
        kpoint_density: 倒空间 k 点密度 (1/Å)；缺省 0.04。
        ismear: ISMEAR 覆盖值（-5 绝缘体/半导体, 0 需 SIGMA, 1 金属）。
        save: 是否将输入文件写入 outputs 目录（默认 True）。

    Returns:
        INCAR / KPOINTS / POTCAR 脚本文本 + 参数校验报告。
    """
    # 1. 解析结构
    try:
        structure = Poscar.from_str(poscar_text).structure
    except Exception as e:  # noqa: BLE001
        return f"错误：POSCAR 解析失败（{e}）"
    comp = structure.composition
    els = [el.symbol for el in comp.elements]

    # 2. 计算类型校验
    if calc_type not in _INCAR_TEMPLATES:
        return f"错误：不支持的 calc_type '{calc_type}'，可选: {', '.join(_INCAR_TEMPLATES)}"

    # 3. 参数与校验
    warnings: list[str] = []

    has_metal = any(el in _METALS for el in els)
    if ismear is None:
        if has_metal:
            ismear = 1
        else:
            ismear = -5
    if has_metal and ismear == -5:
        warnings.append("体系含金属元素，ISMEAR=-5（tetrahedron）不建议用于金属；建议 ISMEAR=1 + SIGMA=0.1")
    if not has_metal and ismear == 1:
        warnings.append("体系为绝缘体/半导体，ISMEAR=1 可接受但 ISMEAR=-5 更精确（需致密 k 点）")

    encut = encut or 500
    if not 200 <= encut <= 1000:
        warnings.append(f"ENCUT={encut} eV 超出常见范围（200-1000），请核对 POTCAR 的 ENMAX")

    density = kpoint_density or 0.04
    if not 0.01 <= density <= 0.2:
        warnings.append(f"k 点密度 {density} 1/Å 超出常见范围（0.02-0.1），请核对")

    # 4. KPOINTS 网格（Monkhorst-Pack 自动网格，按倒空间密度）
    grid = []
    for i in range(3):
        n = max(1, int(math.ceil(2.0 * math.pi / (density * structure.lattice.abc[i]))))
        grid.append(n)
    kpoints_text = (
        "Automatic k-mesh\n"
        "0\n"
        "Monkhorst-Pack\n"
        f"{grid[0]} {grid[1]} {grid[2]}\n"
        "0 0 0\n"
    )

    # 5. INCAR
    tpl = _INCAR_TEMPLATES[calc_type]
    lines = [
        "### MatCalcAgent 生成的 INCAR（请按体系核对后使用） ###",
        f"SYSTEM = {comp.reduced_formula} ({calc_type})",
        f"ENCUT = {encut}",
        "PREC = Accurate",
        f"EDIFF = 1E-5",
        "LREAL = Auto",
    ]
    for key, val in tpl.items():
        if key == "ISMEAR":
            continue  # ISMEAR 在循环后统一写入（含用户覆盖值）
        if val is None:
            continue
        if key == "SIGMA":
            lines.append(f"SIGMA = {val}")
        elif key == "EDIFFG":
            lines.append(f"EDIFFG = {val}")
        else:
            lines.append(f"{key} = {val}")
    lines.append(f"ISMEAR = {ismear}")
    if calc_type in ("relax", "static", "dos", "elastic"):
        lines.append("LCHARG = .TRUE.")
    elif calc_type == "bands":
        lines.append("ICHARG = 11")
    if calc_type == "bands":
        lines.append("# 能带计算需两段：先用 static 生成 CHGCAR，再设 ICHARG=11 + 高对称路径 KPOINTS")
    if calc_type == "elastic":
        lines.append("# 弹性常数建议使用独立脚本对 6 个应变方向分别计算，或采用 IBRION=6 一次性方案")
    incar_text = "\n".join(lines) + "\n"

    # 6. POTCAR 拼接脚本（不捆绑版权数据）
    script_lines = [
        "#!/bin/bash",
        "# MatCalcAgent 生成的 POTCAR 拼接脚本（不包含 POTCAR 数据本身，请自行获取）",
        "# 用法: 设置 VASP_POTCAR_DIR 指向你的 VASP 赝势目录（如 ~/potpaw_PBE），然后运行本脚本",
        f"# 所需元素: {' '.join(els)}",
        "",
        'VASP_POTCAR_DIR="${VASP_POTCAR_DIR:-/path/to/potpaw_PBE}"',
        "OUT=POTCAR",
        "rm -f $OUT",
        *[f'cat "${{VASP_POTCAR_DIR}}/POTCAR.{el}" >> $OUT' for el in els],
        "echo 'POTCAR 拼接完成，检查 ENMAX 并与 INCAR 的 ENCUT 匹配（建议 ENCUT >= 1.3 * max(ENMAX)）'",
    ]
    potcar_script = "\n".join(script_lines) + "\n"

    # 7. 校验报告
    report = [
        f"计算类型: {calc_type}",
        f"元素: {', '.join(els)}",
        f"ENCUT: {encut} eV（建议 >= 1.3 × POTCAR 最大 ENMAX）",
        f"ISMEAR: {ismear}（{'金属建议 1' if has_metal else '绝缘体/半导体建议 -5'}）",
        f"k 点网格: {grid[0]}×{grid[1]}×{grid[2]}（密度 {density} 1/Å）",
    ]
    report.extend(f"- 警告: {w}" for w in warnings)
    if not warnings:
        report.append("- 参数校验通过，无警告")

    # 8. 保存
    save_note = ""
    if save:
        os.makedirs(_OUTPUTS_DIR, exist_ok=True)
        tag = f"{comp.reduced_formula}_{calc_type}_{int(time.time())}"
        d = os.path.join(_OUTPUTS_DIR, tag)
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "INCAR"), "w", encoding="utf-8") as f:
            f.write(incar_text)
        with open(os.path.join(d, "KPOINTS"), "w", encoding="utf-8") as f:
            f.write(kpoints_text)
        with open(os.path.join(d, "POSCAR"), "w", encoding="utf-8") as f:
            f.write(poscar_text)
        with open(os.path.join(d, "make_potcar.sh"), "w", encoding="utf-8") as f:
            f.write(potcar_script)
        save_note = f"\n输入文件已保存到目录: {d}（INCAR / KPOINTS / POSCAR / make_potcar.sh）"

    return (
        f"## 参数校验报告\n" + "\n".join(report) + "\n\n"
        f"## INCAR\n```\n{incar_text}```\n"
        f"## KPOINTS\n```\n{kpoints_text}```\n"
        f"## POTCAR 拼接脚本（bash）\n```bash\n{potcar_script}```{save_note}"
    )


# ─────────────────────────── M2: 结果解析 / 错误诊断 / 远程 ───────────────────────────

# VASP 错误模式库：正则 → (问题说明, 修复建议)
_VASP_ERROR_PATTERNS: list[tuple[str, str, str]] = [
    (r"ZBRENT: fatal error", "电子自洽迭代不收敛（ZBRENT 求根失败）",
     "尝试：增大 NBANDS 20~50%；调节 AMIX/BMIX（如 0.2/0.05）；检查 ISMEAR 与 SIGMA；"
     "使用更小混合步长或 IALGO=48；确认初始磁矩（MAGMOM）合理"),
    (r"TOO FEW BANDS", "能带数不足",
     "在 INCAR 中显式增大 NBANDS（通常 1.5× 价带数）或设置 NBANDS 自动倍率"),
    (r"Error EDDDAV: Call to ZHEGV failed", "EDDDAV 对角化失败（常为内存/线性代数问题）",
     "减少并行核数或改 LPLANE=.FALSE.；增大内存；检查是否有 NaN（初值异常）"),
    (r"internal error in subroutine PACK", "PACK 内部错误",
     "检查 POSCAR/晶格是否合理（原子过近或坐标越界）；减少 k 点数尝试"),
    (r"reached required accuracy", "（信息）离子步已收敛", "正常结果，无需处理"),
    (r"Error reading item .* from file INCAR", "INCAR 参数解析失败",
     "检查 INCAR 中是否有拼写错误、非法取值或重复键"),
    (r"does not match the type of POTCAR", "POSCAR 元素与 POTCAR 顺序不匹配",
     "按 POSCAR 的元素顺序重新拼接 POTCAR"),
    (r"Fatal error", "VASP 致命错误（通用）",
     "查看 Fatal error 上方数行定位具体原因；常见为内存不足、参数非法、结构异常"),
    (r"Segmentation fault|segmentation fault", "段错误（内存访问违规）",
     "检查内存分配（SLURM 内存限制）、并行数；尝试单节点单核复现定位"),
    (r"(?:The job has been killed|Killed|killed)", "任务被杀（常见 OOM 或被调度系统清理）",
     "查看 SLURM 日志的 sacct -j <jobid> -o state；增大内存/缩短 walltime；减少并行核数"),
    (r"Error: integer\*4 overflow", "整数溢出（k 点或网格过大）",
     "减小 KPOINTS 网格或 NPAR 相关设置"),
    (r"^ERROR: ", "（LAMMPS 错误，M4 待完善）",
     "LAMMPS 错误请提供 error 行上下文"),
]


@mcp.tool()
def parse_vasp_output(outcar_text: str) -> str:
    """解析 VASP OUTCAR 文本，提取能量、力、收敛与错误信息。

    Args:
        outcar_text: OUTCAR 文件内容（可传全文或 tail 截断部分）。

    Returns:
        结构化结果摘要（总能、离子步、收敛状态、力、压力、错误）。
    """
    import re

    lines = outcar_text.splitlines()

    # 电子总能（最后一个 TOTEN；OUTCAR 格式: "free  energy   TOTEN  = ..."）
    toten_re = re.compile(r"free\s+energy\s+TOTEN\s*=\s*([-\d.eE+]+)")
    energies = []
    for ln in lines:
        m = toten_re.search(ln)
        if m:
            energies.append(float(m.group(1)))

    # 离子步数（每个离子步一个 F= 行）
    n_ionic = sum(1 for ln in lines if re.search(r"\bF=\s*[-\d.eE+]+", ln))

    # 收敛
    converged = any("reached required accuracy" in ln for ln in lines)
    is_ediffg = any("EDIFFG" in ln and "=" in ln for ln in lines[:30])

    # 最大力（FORCES: max atom, force 行）
    forces = []
    fm_re = re.compile(r"FORCES:\s+max atom, force\s*=\s*([-\d.eE+]+)\s+([-\d.eE+]+)")
    for ln in lines:
        m = fm_re.search(ln)
        if m:
            forces.append((float(m.group(1)), float(m.group(2))))

    # 兜底：static 计算（NSW=0/IBRION=-1）无 FORCES 行，从 TOTAL-FORCE 表解析最大原子受力
    if not forces:
        for i, ln in enumerate(lines):
            if "TOTAL-FORCE" in ln and "(eV/Angst)" in ln:
                max_f = 0.0
                for body in lines[i + 1 :]:
                    parts = body.split()
                    if len(parts) >= 6:
                        try:
                            fx_, fy_, fz_ = (
                                float(parts[3]),
                                float(parts[4]),
                                float(parts[5]),
                            )
                        except ValueError:
                            break
                        mag = (fx_ * fx_ + fy_ * fy_ + fz_ * fz_) ** 0.5
                        max_f = max(max_f, mag)
                    elif len(parts) == 1 and set(parts[0]) <= {"-"}:
                        continue  # 分隔线
                    else:
                        break  # total drift 或块结束
                forces.append((max_f, max_f))
                break

    # 压力
    pressure = None
    pr_re = re.compile(r"external pressure\s*=\s*([-\d.eE+]+)")
    for ln in lines:
        m = pr_re.search(ln)
        if m:
            pressure = float(m.group(1))

    # 错误
    errors = [ln.strip()[:200] for ln in lines if re.search(r"Fatal error|Error", ln)][:5]

    # 终止信息
    finished = any("General timing and accounting informations" in ln for ln in lines)

    out = []
    if energies:
        out.append(f"最终电子总能 (TOTEN): {energies[-1]:.6f} eV")
        out.append(f"记录到的电子能量点数: {len(energies)}")
    else:
        out.append("未找到 free energy TOTEN（可能计算未完成或文本不完整）")
    out.append(f"离子步数: {n_ionic}")
    out.append(f"离子收敛 (reached required accuracy): {'是' if converged else '否'}")
    if is_ediffg and n_ionic > 0 and not converged:
        out.append("注意: 使用 EDIFFG 判据，可能尚未达到力收敛阈值")
    if forces:
        fx, fy = forces[-1]
        out.append(f"最后离子步最大力: {fx:.4f} eV/Å（力判据值 {fy:.4f}）")
    if pressure is not None:
        out.append(f"外部压力: {pressure:.4f} kbar")
    out.append(f"计算正常结束: {'是' if finished else '否（日志截断或中断）'}")
    if errors:
        out.append(f"检测到错误行（前 5 条）: {' | '.join(errors)}")
    else:
        out.append("未检测到明显错误关键字")
    return "\n".join(out)


@mcp.tool()
def diagnose_vasp_error(log_text: str) -> str:
    """诊断 VASP 日志/输出中的错误模式，返回原因与修复建议。

    Args:
        log_text: OUTCAR / slurm 日志 / 终端输出的文本。

    Returns:
        匹配到的错误模式 + 修复建议（未匹配时给出提示）。
    """
    import re

    found = []
    for pattern, reason, advice in _VASP_ERROR_PATTERNS:
        if re.search(pattern, log_text, re.IGNORECASE):
            found.append((pattern, reason, advice))
    if not found:
        return (
            "未识别到已知 VASP 错误模式。\n"
            "建议：1) 提供日志中 'Fatal error' / 'Error' 附近的完整上下文；"
            "2) 检查作业状态 sacct -j <jobid> -o state；3) 确认内存与 walltime 充足。"
        )
    parts = [f"匹配到 {len(found)} 条错误模式："]
    for _, reason, advice in found:
        parts.append(f"- {reason}\n  修复建议: {advice}")
    return "\n".join(parts)


@mcp.tool()
def generate_sbatch(
    job_name: str = "matcalc",
    command: Optional[str] = None,
    partition: Optional[str] = None,
    ntasks: int = 1,
    cpus_per_task: Optional[int] = None,
    walltime: str = "01:00:00",
    modules: Optional[str] = None,
    extra_sbatch: Optional[str] = None,
    scheduler: str = "slurm",
) -> str:
    """生成 HPC 提交脚本（支持 Slurm sbatch 与 Torque/PBS qsub 两种调度后端）。

    Args:
        job_name: 作业名。
        command: 实际执行命令；缺省用配置的 vasp_cmd（如 vasp_std），
            自动加 mpirun 前缀（若含 vasp）。
        partition: 队列/分区名（Slurm --partition / Torque -q）；缺省取配置。
        ntasks: 总核数（Slurm --ntasks / Torque ppn）。
        cpus_per_task: 每任务核数（仅 Slurm 有效，可选）。
        walltime: 时限，如 "01:00:00"。
        modules: 模块加载命令（如 "module load apps/vasp/5.4.4"）；缺省取配置。
        extra_sbatch: 附加 #SBATCH 行（仅 Slurm）。
        scheduler: 调度后端 "slurm"（默认）或 "torque"。

    Returns:
        提交脚本文本（Slurm: run.sbatch / Torque: run.pbs）。
    """
    cfg = remote.load_config()
    partition = partition or cfg["partition"] or ""
    modules = modules or cfg["modules"] or ""

    if command is None:
        vasp_cmd = cfg["vasp_cmd"] or "vasp_std"
        if scheduler.lower() == "torque":
            command = (
                'NP=$(cat $PBS_NODEFILE | wc -l)\n'
                f"mpirun -np $NP -machinefile $PBS_NODEFILE {vasp_cmd}"
            )
        else:
            command = f"mpirun -np $SLURM_NTASKS {vasp_cmd}"

    if scheduler.lower() == "torque":
        lines = [
            "#!/bin/bash",
            f"#PBS -N {job_name}",
            f"#PBS -l nodes=1:ppn={ntasks}",
            "#PBS -e ./job.stderr",
            "#PBS -o ./job.stdout",
        ]
        if partition:
            lines.append(f"#PBS -q {partition}")
        lines += ["#PBS -V", "#PBS -S /bin/bash"]
        if modules:
            lines.append(modules)
        lines += [
            "",
            "cd $PBS_O_WORKDIR",
            'echo "Job started: $(date)"',
            command,
            'echo "Job finished: $(date)"',
        ]
        return "\n".join(lines) + "\n"

    # ---- Slurm 后端（默认） ----
    if command is None:
        pass  # 已在上面构造
    lines = [
        "#!/bin/bash",
        "#SBATCH --job-name=" + job_name,
        f"#SBATCH --ntasks={ntasks}",
    ]
    if cpus_per_task:
        lines.append(f"#SBATCH --cpus-per-task={cpus_per_task}")
    if partition:
        lines.append(f"#SBATCH --partition={partition}")
    lines.append(f"#SBATCH --time={walltime}")
    if extra_sbatch:
        lines.append(extra_sbatch)
    lines += [
        "",
        "# 环境",
        "module purge 2>/dev/null || true",
        modules or "# (未配置模块加载，请按集群环境补充 module load)",
        "",
        "cd $SLURM_SUBMIT_DIR",
        "echo \"Job started: $(date)\"",
        command,
        "echo \"Job finished: $(date)\"",
    ]
    return "\n".join(lines) + "\n"


@mcp.tool()
def configure_remote(
    host: str,
    user: str,
    port: int = 22,
    ssh_key: Optional[str] = None,
    partition: Optional[str] = None,
    modules: Optional[str] = None,
    vasp_cmd: Optional[str] = None,
    remote_workdir: Optional[str] = None,
) -> str:
    """配置远程 HPC 连接信息（SSH key 认证，不保存任何密码/私钥内容）。

    Args:
        host: 远程主机（域名或 IP）。
        user: SSH 用户名。
        port: SSH 端口（默认 22）。
        ssh_key: 私钥路径（如 ~/.ssh/id_ed25519_xxx）；留空用 ssh 默认 key。
        partition: Slurm 分区/队列名。
        modules: 模块加载命令，如 "module load vasp/6.4.3"。
        vasp_cmd: VASP 命令，如 "vasp_std" 或完整路径。
        remote_workdir: 远程工作根目录，如 "~/matcalc"。

    Returns:
        保存后的配置摘要（不含敏感信息）。
    """
    cfg = remote.save_config(
        host=host, user=user, port=port, ssh_key=ssh_key, partition=partition,
        modules=modules, vasp_cmd=vasp_cmd, remote_workdir=remote_workdir,
    )
    masked = {k: ("***" if k in ("password", "key") else v) for k, v in cfg.items()}
    return (
        "远程配置已保存到 remote_config.json（仅连接信息，无凭据）。\n"
        f"当前配置: {masked}\n"
        "下一步建议调用 check_connection 验证 SSH key 连通性。"
    )


@mcp.tool()
def check_connection() -> str:
    """测试远程 SSH 连接（key 认证）并探测 squeue / vasp_std 可用性。"""
    r = remote.check_connection()
    parts = [
        f"退出码: {r.get('exit')}",
        f"stdout: {r.get('stdout', '').strip() or '(空)'}",
        f"stderr: {r.get('stderr', '').strip() or '(空)'}",
        r.get("note", ""),
    ]
    return "\n".join(parts)


@mcp.tool()
def ssh_run(command: str, remote_dir: Optional[str] = None) -> str:
    """在远程执行白名单命令（安全限制：sbatch/squeue/tail/cat 等）。

    Args:
        command: 远程命令（如 "sbatch run.sh"、"tail -30 OUTCAR"）。
        remote_dir: 可选，远程工作目录（缺省用配置的 remote_workdir）。

    Returns:
        远程执行结果（退出码 / stdout / stderr）。
    """
    r = remote.ssh_run(command, remote_dir)
    return (
        f"远程命令: {command}\n退出码: {r.get('exit')}\n"
        f"stdout:\n{r.get('stdout', '').strip() or '(空)'}\n"
        f"stderr:\n{r.get('stderr', '').strip() or '(空)'}"
    )


@mcp.tool()
def upload(local_path: str, remote_path: Optional[str] = None) -> str:
    """上传本地文件到远程（scp）。

    Args:
        local_path: 本地文件路径（如 server/outputs/NaCl_xxx.vasp）。
        remote_path: 远程目标路径；缺省为 remote_workdir 下同名。

    Returns:
        上传结果。
    """
    r = remote.upload(local_path, remote_path)
    return (
        f"上传 {local_path} → 远程\n退出码: {r.get('exit')}\n"
        f"stdout: {r.get('stdout', '').strip() or '(空)'}\n"
        f"stderr: {r.get('stderr', '').strip() or '(空)'}"
    )


@mcp.tool()
def download(remote_path: str, local_path: Optional[str] = None) -> str:
    """从远程下载文件到本地（scp）。

    Args:
        remote_path: 远程文件路径。
        local_path: 本地保存路径；缺省保存到 outputs 目录。

    Returns:
        下载结果。
    """
    r = remote.download(remote_path, local_path)
    return (
        f"下载 {remote_path} → 本地\n退出码: {r.get('exit')}\n"
        f"stdout: {r.get('stdout', '').strip() or '(空)'}\n"
        f"stderr: {r.get('stderr', '').strip() or '(空)'}"
    )


# ==================== M3：常用性质工作流工具（借鉴 VASPKIT / atomate 功能集） ====================


def _save_input_set(tag: str, files: dict, project: Optional[str] = None) -> str:
    """把一组输入文件保存到 outputs/[<project>/inputs/]<tag>_<时间戳>/ 目录。"""
    d = os.path.join(_out_dir(project, "input"), f"{tag}_{int(time.time())}")
    os.makedirs(d, exist_ok=True)
    rows = [f"输入文件已保存到目录: {d}"]
    for name, text in files.items():
        p = os.path.join(d, name)
        with open(p, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        rows.append(f"- {name} ({len(text.splitlines())} 行)")
    return "\n".join(rows)


def _primitive_and_kpath(structure: Structure):
    """取标准原胞与其高对称路径（能带/DOA 计算必须用原胞保证 k 坐标一致）。"""
    from pymatgen.symmetry.analyzer import SpacegroupAnalyzer
    from pymatgen.symmetry.bandstructure import HighSymmKpath

    sga = SpacegroupAnalyzer(structure, symprec=0.01)
    prim = sga.get_primitive_standard_structure()
    hskp = HighSymmKpath(prim)
    kp = hskp.kpath
    return prim, kp["path"], kp["kpoints"]


def _line_mode_kpoints_text(path_segments, kpoint_dict, npts: int) -> str:
    """由路径段生成 VASP line-mode KPOINTS 文本。"""
    lines = [
        "Line-mode K-Path (MatCalcAgent auto-generated)",
        str(npts),
        "Line-mode",
        "rec",
    ]
    for seg in path_segments:
        for a, b in zip(seg[:-1], seg[1:]):
            ka = kpoint_dict[a]
            kb = kpoint_dict[b]
            fmt = lambda lbl, c: "{} {:.6f} {:.6f} {:.6f}".format(lbl, *c)  # noqa: E731
            lines.append("{} {}".format(a.replace("\\Gamma", "GAMMA"), b.replace("\\Gamma", "GAMMA")))
            lines.append(fmt("", ka).strip() + "   " + fmt("", kb).strip())
    return "\n".join(lines) + "\n"


@mcp.tool()
def generate_band_inputs(poscar_text: str, line_density: int = 20, encut: Optional[int] = None, project: Optional[str] = None) -> str:
    """生成两段式能带计算输入（借鉴 VASPKIT 303）：SCF 电荷步 + 非自洽能带步。

    自动生成标准原胞与高对称路径 KPOINTS（line-mode）。

    Args:
        poscar_text: POSCAR 文本（任意惯用胞，将自动转为标准原胞）。
        line_density: 每段高对称路径的插值点数（默认 20）。
        encut: 平面波截断能 (eV)；缺省按体系估算。

    Returns:
        输入文件清单与使用说明（SCF → NSCF 两步流程）。
    """
    struct = Poscar.from_str(poscar_text).structure
    prim, segments, kdict = _primitive_and_kpath(struct)
    comp = prim.composition
    encut_v = encut if encut else max(400, int(max(float(Element(el.symbol).Z) for el in comp.elements) * 50))
    prim_poscar = _to_vasp5_poscar(prim)

    incar_scf = "\n".join(
        [
            "### Step1 SCF：收敛电荷密度（生成 CHGCAR）###",
            f"SYSTEM = {comp.reduced_formula} band-scf",
            f"ENCUT = {encut_v}",
            "PREC = Accurate",
            "EDIFF = 1E-6",
            f"ISMEAR = 0",
            "SIGMA = 0.05",
            "LCHARG = .TRUE.",
            "LWAVE = .FALSE.",
            "NCORE = 4",
            "",
        ]
    )
    incar_band = "\n".join(
        [
            "### Step2 NSCF：沿高对称路径算本征值（读 Step1 的 CHGCAR）###",
            f"SYSTEM = {comp.reduced_formula} band-nscf",
            f"ENCUT = {encut_v}",
            "PREC = Accurate",
            "EDIFF = 1E-6",
            "ICHARG = 11          ! 非自洽：固定电荷",
            "LCHARG = .FALSE.",
            "LWAVE = .FALSE.",
            "NCORE = 4",
            "",
        ]
    )
    kpoints_band = _line_mode_kpoints_text(segments, kdict, line_density)
    potcar_sh = (
        "#!/bin/bash\n# POTCAR 拼接脚本（设置 VASP_POTCAR_DIR 后运行）\n"
        'VASP_POTCAR_DIR="${VASP_POTCAR_DIR:?请设置赝势目录}"\n'
        "rm -f POTCAR\nfor el in @ELS@ ; do\n"
        '  cat "$VASP_POTCAR_DIR/$el/POTCAR" >> POTCAR || exit 1\ndone\necho done\n'
    ).replace("@ELS@", " ".join(el.symbol for el in comp.elements))
    saved = _save_input_set(
        "band_inputs",
        {
            "POSCAR": prim_poscar,
            "INCAR_step1_SCF": incar_scf,
            "INCAR_step2_NSCF": incar_band,
            "KPOINTS_band": kpoints_band,
            "make_potcar.sh": potcar_sh,
        },
        project=project,
    )
    labels = "-".join(seg[0] + ".." + seg[-1] for seg in segments)
    return (
        saved
        + "\n\n使用流程:\n"
        + "1. make_potcar.sh 生成 POTCAR\n"
        + "2. 用目录内 POSCAR + INCAR_step1_SCF + 普通 Gamma 网格 KPOINTS 做 SCF（得到 CHGCAR）\n"
        + "3. 复制 CHGCAR，换 INCAR_step2_NSCF + KPOINTS_band 做非自洽能带\n"
        + f"4. 高对称路径段: {labels}\n"
        + "5. 完成后下载 vasprun.xml，用 plot_band 工具绘图"
    )


@mcp.tool()
def generate_dos_inputs(poscar_text: str, nedos: int = 2001, encut: Optional[int] = None, include_pdos: bool = True, project: Optional[str] = None) -> str:
    """生成态密度（DOS/PDOS）计算输入（借鉴 VASPKIT 111/112）。

    Args:
        poscar_text: POSCAR 文本。
        nedos: 态密度采样点数（默认 2001，VASPKIT 推荐 ≥2000）。
        encut: 平面波截断能 (eV)；缺省按体系估算。
        include_pdos: 是否开启投影态密度（LORBIT=11）。

    Returns:
        输入文件清单与说明。
    """
    struct = Poscar.from_str(poscar_text).structure
    prim, _, _ = _primitive_and_kpath(struct)
    comp = prim.composition
    encut_v = encut if encut else max(400, int(max(float(Element(el.symbol).Z) for el in comp.elements) * 50))
    # DOS 需要精细 k 网格：在自动网格基础上加密一倍
    kden = 0.05  # 更密的密度（M1 默认 0.04 → 这里更细）
    a_len = max(prim.lattice.abc)
    n_k = max(4, min(40, math.ceil(2 * math.pi / (kden * a_len))))
    kpoints_txt = (
        "Automatic dense mesh for DOS (MatCalcAgent)\n0\nGamma\n"
        f"{n_k} {n_k} {n_k}\n0 0 0\n"
    )
    incar = ["### DOS 计算 INCAAR（MatCalcAgent 生成，请核对体系后使用） ###",
             f"SYSTEM = {comp.reduced_formula} dos",
             f"ENCUT = {encut_v}",
             "PREC = Accurate",
             "EDIFF = 1E-6",
             "ISMEAR = -5          # 四面体方法（绝缘体/半导体最佳；金属请改 ISMEAR=1 且减小 SIGMA）",
             f"NEDOS = {nedos}",
             "LORBIT = 11          # 输出 PDOS（分波态密度）" if include_pdos else "# 未开启 PDOS",
             "LCHARG = .TRUE.",
             "LWAVE = .FALSE.",
             "NCORE = 4", ""]
    potcar_sh = (
        "#!/bin/bash\nVASP_POTCAR_DIR=\"${VASP_POTCAR_DIR:?请设置赝势目录}\"\n"
        "rm -f POTCAR\nfor el in @ELS@ ; do\n"
        '  cat "$VASP_POTCAR_DIR/$el/POTCAR" >> POTCAR || exit 1\ndone\necho done\n'
    ).replace("@ELS@", " ".join(el.symbol for el in comp.elements))
    saved = _save_input_set(
        "dos_inputs",
        {"POSCAR": _to_vasp5_poscar(prim), "INCAR": "\n".join(incar), "KPOINTS": kpoints_txt, "make_potcar.sh": potcar_sh},
        project=project,
    )
    return saved + f"\n\n说明: k 网格 {n_k}x{n_k}x{n_k}；完成后下载 vasprun.xml 用 plot_dos 工具绘图"


@mcp.tool()
def analyze_vasprun(file_path: str) -> str:
    """解析本地 vasprun.xml，输出计算摘要：能量/带隙/费米能/磁矩/最大力/关键参数。

    Args:
        file_path: 本地 vasprun.xml 路径（可先用 download 从远程拉回）。

    Returns:
        结构化摘要文本。
    """
    import numpy as np  # noqa: F401  pymatgen 依赖链自带

    from pymatgen.io.vasp.outputs import Vasprun

    if not os.path.isabs(file_path) and not os.path.exists(file_path):
        cand = os.path.join(_OUTPUTS_DIR, file_path)
        if os.path.exists(cand):
            file_path = cand
    v = Vasprun(file_path, parse_projected_eigen=False, exception_on_bad_xml=False)
    rows = []
    rows.append(f"文件: {file_path}")
    try:
        gap, cbm, vbm, is_direct = v.eigenvalue_band_properties
        d = "直接" if is_direct else "间接"
        rows.append(f"带隙: {gap:.4f} eV（{d}；CBM {cbm:.4f} / VBM {vbm:.4f}）")
    except Exception as exc:  # noqa: BLE001
        rows.append(f"带隙: 未能解析（{type(exc).__name__}: 可能金属或数据不完整）")
    rows.append(f"最终总能 E0: {v.final_energy:.6f} eV")
    try:
        rows.append(f"费米能: {v.efermi:.4f} eV")
    except Exception:  # noqa: BLE001
        pass
    nelect = v.parameters.get("NELECT")
    if nelect:
        rows.append(f"电子数 NELECT: {nelect}")
    encut = v.incar.get("ENCUT") or v.parameters.get("ENCUT")
    ediff = v.incar.get("EDIFF") or v.parameters.get("EDIFF")
    ismear = v.incar.get("ISMEAR", v.parameters.get("ISMEAR", "N/A"))
    rows.append(f"参数: ENCUT={encut}, EDIFF={ediff}, ISMEAR={ismear}")
    steps = v.ionic_steps
    rows.append(f"离子步数: {len(steps)}")
    if steps:
        last = steps[-1]
        f_arr = last.get("forces")
        if f_arr is not None:
            import math as _m

            max_f = max(_m.sqrt(sum(c * c for c in row)) for row in f_arr)
            rows.append(f"最后一步最大原子力: {max_f:.4f} eV/Å")
        e_fr = last.get("e_fr_energy")
        if e_fr is not None:
            rows.append(f"最后一步自由能 F: {e_fr:.6f} eV")
    try:
        tmag = getattr(v, "total_mag", None)
        if tmag is not None and abs(tmag) > 1e-8:
            rows.append(f"总磁矩: {tmag:.4f} μB")
    except Exception:  # noqa: BLE001
        pass
    return "\n".join(rows)


def _export_origin_txt(base_path: str, header: list[str], x_vals, columns: list) -> str:
    """导出 Origin 友好的 tab 分隔数据文件（# 注释表头 + 数值列），返回路径。"""
    p = base_path + ".txt"
    lines = ["# " + "\t".join(header)]
    for i in range(len(x_vals)):
        rows = [f"{x_vals[i]:.4f}"] + [f"{col[i]:.6f}" for col in columns]
        lines.append("\t".join(rows))
    with open(p, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return p


@mcp.tool()
def plot_dos(vasprun_path: str, spin_polarized: bool = True, emin: float = -10.0, emax: float = 10.0, save: bool = True, project: Optional[str] = None) -> str:
    """从本地 vasprun.xml 绘制总态密度（TDOS）图（PNG）。

    Args:
        vasprun_path: 本地 vasprun.xml 路径。
        spin_polarized: 是否区分自旋通道（非极化体系自动忽略）。
        emin/emax: 相对费米能的能量窗口 (eV)。
        save: 是否保存到 outputs 目录。

    Returns:
        图片路径与图内容说明。
    """
    from pymatgen.electronic_structure.core import Spin
    from pymatgen.io.vasp.outputs import Vasprun

    v = Vasprun(vasprun_path, parse_projected_eigen=False, exception_on_bad_xml=False)
    tdos = v.tdos
    ef = tdos.efermi
    fig, ax = plt.subplots(figsize=(6, 4.5), dpi=150)
    up_mask = (tdos.energies - ef >= emin) & (tdos.energies - ef <= emax)
    en = tdos.energies[up_mask] - ef
    ax.plot(en, tdos.densities[Spin.up][up_mask], color="#2b6cb0", lw=1.4, label="spin-up")
    has_dn = Spin.down in tdos.densities
    if has_dn:
        ax.plot(en, -tdos.densities[Spin.down][up_mask], color="#c53030", lw=1.4, label="spin-down")
        ax.axhline(0, color="gray", lw=0.6)
    else:
        ax.fill_between(en, tdos.densities[Spin.up][up_mask], alpha=0.25, color="#2b6cb0")
    ax.axvline(0, color="black", ls="--", lw=0.9)
    ax.text(0.15, ax.get_ylim()[1] * 0.92, "$E_F$", fontsize=10)
    ax.set_xlabel("E - E$_F$ (eV)")
    ax.set_ylabel("DOS (states/eV)")
    formula = v.final_structure.composition.reduced_formula
    ax.set_title(f"Total DOS — {formula}")
    ax.legend(loc="best", fontsize=8)
    fig.tight_layout()
    out_png = ""
    out_txt = ""
    if save:
        stamp = int(time.time())
        out_png = os.path.join(_out_dir(project, "dos"), f"tdos_{formula}_{stamp}.png")
        fig.savefig(out_png)
        cols = [tdos.densities[Spin.up][up_mask]]
        heads = ["TDOS_up"]
        if has_dn:
            cols.append(tdos.densities[Spin.down][up_mask])
            heads.append("TDOS_down(取负后为-DOS)")
        out_txt = _export_origin_txt(
            os.path.join(_out_dir(project, "dos"), f"tdos_{formula}_{stamp}"),
            ["E-EF(eV)"] + heads,
            en,
            cols,
        )
    plt.close(fig)
    note = "上下自旋分别绘制（下旋取负值）" if has_dn else "非极化，单自旋通道"
    msg = f"DOS 图已生成: {out_png}\n内容: {note}; 费米能 {ef:.3f} eV; 能量窗口 [{emin}, {emax}] eV"
    if out_txt:
        msg += f"\n数据文件（Origin 可直接导入）: {out_txt}"
    return msg


@mcp.tool()
def plot_band(vasprun_path: str, kpoints_path: str, save: bool = True, project: Optional[str] = None) -> str:
    """从本地 vasprun.xml + line-mode KPOINTS 绘制能带结构图（PNG）。

    Args:
        vasprun_path: NSCF 步的 vasprun.xml 路径。
        kpoints_path: 对应的 line-mode KPOINTS 路径。
        save: 是否保存到 outputs。

    Returns:
        图片路径与摘要（含带隙）。
    """
    from pymatgen.electronic_structure.plotter import BSPlotter
    from pymatgen.io.vasp.outputs import Vasprun

    def _resolve(p: str) -> str:
        if not os.path.isabs(p) and not os.path.exists(p):
            cand = os.path.join(_OUTPUTS_DIR, p)
            if os.path.exists(cand):
                return cand
        return p

    vp, kp = _resolve(vasprun_path), _resolve(kpoints_path)
    v = Vasprun(vp, parse_projected_eigen=False, exception_on_bad_xml=False)
    bs = v.get_band_structure(kpoints_filename=kp)
    plotter = BSPlotter(bs)
    ax = plotter.get_plot(ylim=None)
    fig = ax.figure
    formula = v.final_structure.composition.reduced_formula
    fig.suptitle(f"Band Structure — {formula}", fontsize=12)
    fig.tight_layout()
    out_png = ""
    if save:
        out_png = os.path.join(_out_dir(project, "result"), f"bands_{formula}_{int(time.time())}.png")
        fig.savefig(out_png)
    plt.close(fig)
    try:
        gap = bs.get_band_gap()
        direct = "直接" if gap.get("direct") else "间接"
        gap_e = gap.get("energy", 0.0)
        gap_note = f"带隙 {gap_e:.4f} eV（{direct}），CBM/VBM 见图"
    except Exception:  # noqa: BLE001
        gap_note = "带隙信息未能提取（可能金属）"
    return f"能带图已生成: {out_png}\n{gap_note}"


@mcp.tool()
def export_report(title: str, sections: str, fmt: str = "markdown", project: Optional[str] = None) -> str:
    """将计算结果整理为报告文件并保存到 outputs 目录。

    Args:
        title: 报告标题。
        sections: 报告正文（Markdown 文本；小节以 '## ' 开头组织）。
        fmt: 导出格式 markdown|html（html 会做最小样式包装便于打印成 PDF）。

    Returns:
        保存路径与预览信息。
    """
    stamp = time.strftime("%Y-%m-%d %H:%M")
    header = f"# {title}\n\n> 由 MatCalcAgent 生成 · {stamp}\n\n"
    body = sections if sections.strip().startswith("#") else header + sections
    if fmt.lower() == "html":
        html = (
            "<!DOCTYPE html><html><head><meta charset='utf-8'>"
            "<style>body{font-family:'Segoe UI',sans-serif;max-width:820px;margin:32px auto;"
            "color:#222;line-height:1.65}table{border-collapse:collapse}td,th{border:1px solid #ccc;"
            "padding:6px 10px}code{background:#f4f4f4;padding:2px 5px;border-radius:3px}</style>"
            "</head><body>" + body.replace("\n", "<br>") + "</body></html>"
        )
        path = os.path.join(_out_dir(project, "report"), f"report_{int(time.time())}.html")
        with open(path, "w", encoding="utf-8") as f:
            f.write(html)
    else:
        path = os.path.join(_out_dir(project, "report"), f"report_{int(time.time())}.md")
        with open(path, "w", encoding="utf-8") as f:
            f.write(body)
    return f"报告已保存: {path}\n标题: {title}\n正文长度: {len(body)} 字符"


@mcp.tool()
def generate_optical_inputs(poscar_text: str, encut: Optional[int] = None, nedos: int = 2000, cshift: float = 0.1, omegamax: float = 40.0, project: Optional[str] = None) -> str:
    """生成光学性质（介电函数/吸收谱）两步计算输入（借鉴 VASPKIT 711-714）。

    Step1 SCF 收敛电荷；Step2 LOPTICS=.TRUE. 非自洽计算虚部介电函数。

    Args:
        poscar_text: POSCAR 文本。
        encut: 截断能 (eV)；缺省按体系估算。
        nedos: 光谱采样点数。
        cshift: 展宽参数 CSHIFT (eV)。
        omegamax: 最大频率 OMEGAMAX (eV)。

    Returns:
        输入文件清单与流程说明。
    """
    struct = Poscar.from_str(poscar_text).structure
    comp = struct.composition
    encut_v = encut if encut else max(400, int(max(float(Element(el.symbol).Z) for el in comp.elements) * 50))
    incar1 = "\n".join([
        "### Step1 SCF（生成 CHGCAR）###", f"SYSTEM = {comp.reduced_formula} opt-scf",
        f"ENCUT = {encut_v}", "EDIFF = 1E-6", "ISMEAR = 0", "SIGMA = 0.05",
        "LCHARG = .TRUE.", "LWAVE = .FALSE.", "",
    ])
    incar2 = "\n".join([
        "### Step2 光学：非自洽 + LOPTICS（读 CHGCAR，输出实/虚介电函数到 vasprun.xml）###",
        f"SYSTEM = {comp.reduced_formula} optical",
        f"ENCUT = {encut_v}", "ICHARG = 11", "LOPTICS = .TRUE.",
        f"CSHIFT = {cshift}", f"OMEGAMAX = {omegamax}", f"NEDOS = {nedos}",
        "ISMEAR = 0", "SIGMA = 0.05", "LWAVE = .FALSE.", "LCHARG = .FALSE.", "",
    ])
    saved = _save_input_set("optical_inputs", {"POSCAR": _to_vasp5_poscar(struct), "INCAR_step1_SCF": incar1, "INCAR_step2_optics": incar2}, project=project)
    return saved + "\n\n说明: 完成后 vasprun.xml 含 dielectric function；吸收系数 α(ω)、折射率等可由实虚部 ε1/ε2 后处理得到"


@mcp.tool()
def generate_elastic_inputs(poscar_text: str, encut: Optional[int] = None, pstress: float = 0.0, project: Optional[str] = None) -> str:
    """生成弹性常数计算输入（VASP 内置 IBRION=6 应力-应变法，借鉴 VASPKIT 20x）。

    Args:
        poscar_text: POSCAR 文本（建议先用充分弛豫的 CONTCAR）。
        encut: 截断能 (eV)。
        pstress: 扰动应力上限 (kBar)，默认 0（VASP 自动选步长）。

    Returns:
        输入文件清单与结果提取说明。
    """
    struct = Poscar.from_str(poscar_text).structure
    comp = struct.composition
    encut_v = encut if encut else max(500, int(max(float(Element(el.symbol).Z) for el in comp.elements) * 60))
    incar = "\n".join([
        "### 弹性常数（IBRION=6 应力-应变法；要求结构已充分弛豫）###",
        f"SYSTEM = {comp.reduced_formula} elastic",
        f"ENCUT = {encut_v}",
        "EDIFF = 1E-6          # 必须比常规更紧",
        "IBRION = 6            # 计算弹性常数",
        "ISIF = 3              # 计算刚性离子弹性常数 + 内应变张量",
        "NFREE = 4             # 每个形变用 4 个位移",
        f"PSTRESS = {pstress}",
        "NSW = 1",
        "PREC = High",
        "ISMEAR = 0",
        "SIGMA = 0.05",
        "NCORE = 4", "",
    ])
    saved = _save_input_set(
        "elastic_inputs",
        {"POSCAR": _to_vasp5_poscar(struct), "INCAR": incar},
        project=project,
    )
    return saved + "\n\n说明: OUTCAR 末尾 'ELASTIC MODULI' 表给出对称化弹性常数矩阵（GPa）；立方体系看 C11/C12/C44，可算体模量 B=(C11+2C12)/3。注意 k 网格需收敛良好"


@mcp.tool()
def generate_eos_inputs(poscar_text: str, scale_min: float = 0.96, scale_max: float = 1.04, n_points: int = 7, project: Optional[str] = None) -> str:
    """生成状态方程（EOS）体积扫描输入集：按晶格缩放生成 n 个结构目录。

    Args:
        poscar_text: 已弛豫的 POSCAR 文本。
        scale_min/scale_max: 晶格缩放因子范围（如 0.96~1.04 即 ±4% 体积扫描）。
        n_points: 采样点数（默认 7）。

    Returns:
        各缩放点目录清单；跑完后收集 E-V 数据调用 fit_eos 拟合。
    """
    from pymatgen.core.lattice import Lattice

    struct = Poscar.from_str(poscar_text).structure
    v0 = struct.volume
    scales = [scale_min + i * (scale_max - scale_min) / (n_points - 1) for i in range(n_points)]
    rows = [f"EOS 扫描集（{n_points} 点，缩放 {scale_min}~{scale_max}）已保存:"]
    for i, s in enumerate(scales, 1):
        st = struct.copy()
        st.scale_lattice(v0 * s**3)
        d = os.path.join(_out_dir(project, "input"), f"eos_scan_{int(time.time())}_{i:02d}")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "POSCAR"), "w", encoding="utf-8", newline="\n") as f:
            f.write(_to_vasp5_poscar(st))
        rows.append(f"- {d}  缩放 {s:.4f}, V={st.volume:.3f} Å³")
    rows.append("\n流程: 对每个目录做同参数 static 计算 → 收集 (V, E) → 调用 fit_eos 得到平衡体积/体模量")
    return "\n".join(rows)


@mcp.tool()
def fit_eos(volumes: list[float], energies: list[float]) -> str:
    """Birch-Murnaghan 三阶状态方程拟合 E(V) 数据。

    Args:
        volumes: 体积列表 (Å³)，与 energies 一一对应。
        energies: 总能列表 (eV)。

    Returns:
        平衡体积 V0 / 体模量 B0 / 压强导数 B0' / 最小能量 E0 与拟合质量。
    """
    from pymatgen.analysis.eos import BirchMurnaghan

    if len(volumes) != len(energies) or len(volumes) < 4:
        return "错误: 需要 ≥4 组 (V, E) 数据且长度一致"
    eos = BirchMurnaghan(list(volumes), list(energies))
    eos.fit()
    rows = [
        "Birch-Murnaghan 三阶 EOS 拟合结果:",
        f"平衡体积 V0 = {eos.v0:.4f} Å³",
        f"体模量 B0 = {eos.b0_GPa:.2f} GPa ({eos.b0:.6f} eV/Å³)",
        f"B0' = {eos.b1:.3f}",
        f"最小能量 E0 = {eos.e0:.6f} eV",
    ]
    # 拟合残差
    e_fit = [eos.func(v_) for v_ in volumes]
    rms = (sum((e - ef) ** 2 for e, ef in zip(energies, e_fit)) / len(volumes)) ** 0.5
    rows.append(f"拟合 RMS 残差 = {rms:.6f} eV（< 1 meV/atom 为佳）")
    return "\n".join(rows)


@mcp.tool()
def make_supercell(poscar_text: str, a: int = 2, b: int = 2, c: int = 2) -> str:
    """将结构扩展为 a×b×c 超胞并输出 POSCAR。

    Args:
        poscar_text: POSCAR 文本。
        a/b/c: 各方向扩胞倍数。

    Returns:
        新 POSCAR 文本（可直接保存或上传）。
    """
    st = Poscar.from_str(poscar_text).structure
    sup = st.copy()
    sup.make_supercell([a, b, c])
    head = (
        f"超胞 {a}x{b}x{c}: {len(st)} 原子 → {len(sup)} 原子, "
        f"V={sup.volume:.2f} Å³\n```\n"
    )
    return head + _to_vasp5_poscar(sup) + "```"


@mcp.tool()
def cleave_surface(poscar_text: str, miller: str, slab_height: float = 12.0, vacuum: float = 12.0) -> str:
    """切表面模型（Slab）：按米勒指数生成表面板层 + 真空层（借鉴 VASPKIT 28x）。

    Args:
        poscar_text: 体相 POSCAR 文本。
        miller: 米勒指数，如 "1 1 0" 或 "-1 -1 1"。
        slab_height: 板层最小厚度 (Å)。
        vacuum: 真空层厚度 (Å)。

    Returns:
        生成的 slab 数量与第一个端型的 POSCAR 文本。
    """
    from pymatgen.core.surface import SlabGenerator

    st = Poscar.from_str(poscar_text).structure
    hkl = tuple(int(x) for x in miller.replace(",", " ").split())
    if len(hkl) != 3:
        return f"错误: miller 需要三个整数，收到 '{miller}'"
    gen = SlabGenerator(st, hkl, min_slab_size=slab_height, min_vacuum_size=vacuum, primitive=False)
    slabs = gen.get_slabs(symmetrize=True)
    if not slabs:
        return f"错误: ({hkl[0]} {hkl[1]} {hkl[2]}) 未生成对称 slab，尝试调整厚度或关闭对称化"
    first = slabs[0]
    info = [
        f"({hkl[0]} {hkl[1]} {hkl[2]}) 表面: 共 {len(slabs)} 个对称端型",
        f"slab 原子数: {len(first)}, 板层 {slab_height} Å + 真空 {vacuum} Å",
        "提示: 不同端型表面能不同，建议分别计算后比较。",
    ]
    return "\n".join(info) + "\n```\n" + _to_vasp5_poscar(first) + "```"


@mcp.tool()
def plot_pdos(
    vasprun_path: str,
    split: str = "valence",
    elements: Optional[str] = None,
    emin: float = -10.0,
    emax: float = 10.0,
    min_contrib: float = 0.05,
    top_n: Optional[int] = None,
    stack: bool = False,
    save: bool = True,
    project: Optional[str] = None,
) -> str:
    """绘制投影态密度 PDOS（PNG），自动只画主要贡献轨道。

    spin-up 向上、spin-down 取负号向下（VASPKIT 惯例）。要求 vasprun.xml 含
    投影数据（计算 INCAR 需 LORBIT=11，可用 generate_dos_inputs 生成）。

    Args:
        vasprun_path: 本地 vasprun.xml 路径。
        split: "valence"=每元素一条主价壳层曲线（自动判别并标注 Mn3d/O2p/Na3s 等,
            默认）; "element"=每元素总量; "orbitals"=粗粒度 s/p/d;
            "fine"=细分轨道（p→px/py/pz, d→dxy/dyz/dxz/dx2-y2/dz2）。
        elements: 逗号分隔元素符号（如 "Mn,Ni,O"）；缺省画全部元素。
        emin/emax: 相对费米能的能量窗口 (eV)。
        min_contrib: 主要贡献阈值——窗口内积分占比低于此值的轨道不画（默认 5%）。
        top_n: 显式只画贡献最大的前 N 条曲线（给出时覆盖 min_contrib）。
        stack: True 时分轨曲线以堆叠面积图呈现（↑向上堆叠、↓负向向下堆叠）。
        save: 是否保存到 outputs（图 + Origin 数据 .txt）。

    Returns:
        图片路径、保留/忽略的轨道及内容说明。
    """
    import numpy as np
    from types import SimpleNamespace

    from pymatgen.electronic_structure.core import Spin
    from pymatgen.io.vasp.outputs import Vasprun

    def _resolve(p: str) -> str:
        if not os.path.isabs(p) and not os.path.exists(p):
            cand = os.path.join(_OUTPUTS_DIR, p)
            if os.path.exists(cand):
                return cand
        return p

    v = Vasprun(_resolve(vasprun_path), parse_projected_eigen=True, exception_on_bad_xml=False)
    cdos = v.complete_dos
    ef = cdos.efermi
    formula = v.final_structure.composition.reduced_formula

    all_syms: list[str] = []
    for site in v.final_structure:
        if site.specie.symbol not in all_syms:
            all_syms.append(site.specie.symbol)
    want = [s.strip() for s in elements.split(",")] if elements else all_syms
    unknown = [s for s in want if s not in all_syms]
    if unknown:
        return f"错误: 元素 {unknown} 不在体系中（含 {all_syms}）"

    # ---- 窗口积分工具（曲线组装与筛选共用）----
    def _integral(dos_like) -> float:
        m = (np.asarray(dos_like.energies) - ef >= emin) & (np.asarray(dos_like.energies) - ef <= emax)
        trapz_fn = getattr(np, "trapezoid", None) or np.trapz
        tot = 0.0
        for arr in dos_like.densities.values():
            a = np.asarray(arr)[m]
            tot += float(trapz_fn(a, np.asarray(dos_like.energies)[m]))
        return abs(tot)

    # ---- 组装候选曲线 ----
    def _shell_n(sym: str, shell: str) -> int:
        """由原子序数推断价壳层主量子数 n（用于 Mn3d/O2p 式标注）。"""
        from pymatgen.core import Element as _E2

        z = _E2(sym).Z
        if shell == "d":
            return 3 if z <= 30 else 4 if z <= 48 else 5 if z <= 80 else 6
        if z <= 2:
            return 1
        if z <= 10:
            return 2
        if z <= 18:
            return 3
        if z <= 36:
            return 4
        if z <= 54:
            return 5
        return 6

    curves: list[tuple[str, object]] = []  # (label, dos-like)
    if split == "valence":
        # 每元素取窗口内积分贡献最大的粗壳层作为其"主价层"，标注如 Mn3d / O2p / Na3s
        for sym in want:
            spd = cdos.get_element_spd_dos(_elem(sym))
            best_name, best_ot, best_w = None, None, -1.0
            for name in ("s", "p", "d", "f"):
                ot = getattr(OrbitalType_safe(), name, None)
                if ot is not None and ot in spd:
                    w = _integral(spd[ot])
                    if w > best_w:
                        best_name, best_ot, best_w = name, ot, w
            if best_ot is not None:
                curves.append((f"{sym}{_shell_n(sym, best_name)}{best_name}", spd[best_ot]))
    elif split == "element":
        for sym in want:
            edos = cdos.get_element_dos().get(_elem(sym))
            if edos is not None:
                curves.append((sym, edos))
    elif split == "orbitals":
        for sym in want:
            spd = cdos.get_element_spd_dos(_elem(sym))
            for oname in ("s", "p", "d", "f"):
                ot = getattr(OrbitalType_safe(), oname, None)
                if ot is not None and ot in spd:
                    curves.append((f"{sym}-{oname}", spd[ot]))
    elif split == "fine":
        fine_labels = {"s": "s", "px": "px", "py": "py", "pz": "pz",
                       "dxy": "dxy", "dyz": "dyz", "dz2": "dz2", "dxz": "dxz",
                       "dx2": "dx2-y2"}
        _shell_of = {"s": "s", "px": "p", "py": "p", "pz": "p",
                     "dxy": "d", "dyz": "d", "dz2": "d", "dxz": "d", "dx2": "d"}
        for sym in want:
            sites = [s for s in v.final_structure if s.specie.symbol == sym]
            agg: dict[str, dict] = {}
            for site in sites:
                for ot, arr in cdos.pdos.get(site, {}).items():
                    name = getattr(ot, "name", str(ot))
                    bucket = agg.setdefault(name, {})
                    for sp, vals in arr.items():
                        bucket[sp] = bucket.get(sp, 0) + vals
            # 自动限定在该元素的主价壳层内细分（与 valence 判定一致）
            spd_all = cdos.get_element_spd_dos(_elem(sym))
            best_shell, best_w = None, -1.0
            for name in ("s", "p", "d", "f"):
                ot = getattr(OrbitalType_safe(), name, None)
                if ot is not None and ot in spd_all:
                    w = _integral(spd_all[ot])
                    if w > best_w:
                        best_shell, best_w = name, w
            for raw, disp in fine_labels.items():
                if raw in agg and (best_shell is None or _shell_of.get(raw) == best_shell):
                    curves.append((f"{sym}-{disp}", SimpleNamespace(energies=cdos.energies, densities=agg[raw])))
    else:
        return f"错误: split 仅支持 valence|element|orbitals|fine，收到 '{split}'"

    if not curves:
        return "错误: 未生成任何 PDOS 曲线（确认 vasprun.xml 含投影数据，即计算时 LORBIT=11）"

    # ---- 主要贡献筛选（窗口积分占比）----
    weights = [(label, _integral(d)) for label, d in curves]
    total_w = sum(w for _, w in weights) or 1.0
    ranked = sorted(weights, key=lambda t: t[1], reverse=True)
    if top_n:
        kept_labels = {lb for lb, _ in ranked[: max(1, int(top_n))]}
    else:
        kept_labels = {lb for lb, w in ranked if w / total_w >= min_contrib}
    if not kept_labels:
        kept_labels = {ranked[0][0]}
    dropped = [(lb, w / total_w * 100) for lb, w in ranked if lb not in kept_labels]

    selected = [(lb, d) for lb, d in curves if lb in kept_labels]

    export_headers: list[str] = []
    export_cols: list = []
    export_x = None

    def _plot_curve(ax, dos, label: str, color=None, linestyle="-") -> None:
        nonlocal export_x
        m = (np.asarray(dos.energies) - ef >= emin) & (np.asarray(dos.energies) - ef <= emax)
        en = np.asarray(dos.energies)[m] - ef
        up = dos.densities.get(Spin.up)
        dn = dos.densities.get(Spin.down)
        kw = {"lw": 1.4, "linestyle": linestyle}
        if color is not None:
            kw["color"] = color
        if up is not None:
            up_arr = np.asarray(up)[m]
            ax.plot(en, up_arr, label=label + " (↑)", **kw)
            export_headers.append(f"{label}_up")
            export_cols.append(list(up_arr))
            export_x = list(en)
        if dn is not None:
            dn_arr = np.asarray(dn)[m]
            kwd = dict(kw)
            kwd["alpha"] = 0.85
            ax.plot(en, -dn_arr, label=label + " (↓)", **kwd)
            export_headers.append(f"{label}_down")
            export_cols.append(list(-dn_arr))

    fig, ax = plt.subplots(figsize=(7.2, 5.0), dpi=150)
    palette = plt.rcParams["axes.prop_cycle"].by_key().get("color", ["#2b6cb0", "#c53030", "#2f855a", "#b7791f"])
    has_dn = Spin.down in cdos.densities
    en0 = np.asarray(cdos.energies)
    m0 = (en0 - ef >= emin) & (en0 - ef <= emax)
    export_x = list(en0[m0] - ef)

    def _chan(dos, spin):
        a = dos.densities.get(spin)
        if a is None:
            return np.zeros(m0.sum())
        return np.asarray(a)[m0]

    if stack and len(selected) > 1:
        # ---- 每元素一个子图；子图内各分轨 ↑ 向上堆叠、↓ 取负向下堆叠 ----
        import re as _re

        groups: dict[str, list] = {}
        order: list[str] = []
        for lb, d in selected:
            mm = _re.match(r"([A-Z][a-z]?)", lb)
            sym = mm.group(1) if mm else lb
            if sym not in groups:
                order.append(sym)
                groups[sym] = []
            groups[sym].append((lb, d))

        import math as _math

        ncols = 2 if len(order) > 3 else 1
        nrows = _math.ceil(len(order) / ncols)
        fig, axes = plt.subplots(nrows, ncols, figsize=(6.5 * ncols, 2.9 * nrows), dpi=150,
                                 sharex=True, squeeze=False)
        y_top, y_bot = 1e-9, 0.0
        for gi, sym in enumerate(order):
            axp = axes[gi // ncols][gi % ncols]
            base = np.zeros(m0.sum())  # 共享累积基线: up 向上、down 镜像向下
            for i, (lb, d) in enumerate(groups[sym]):
                col = palette[i % len(palette)]
                up_arr = _chan(d, Spin.up)
                top = base + up_arr
                axp.fill_between(en0[m0] - ef, base, top, color=col, alpha=0.6, linewidth=0, label=lb)
                axp.plot(en0[m0] - ef, top, color=col, lw=1.0)
                export_headers.append(f"{lb}_up")
                export_cols.append(list(up_arr))
                if has_dn:
                    dn_arr = _chan(d, Spin.down)
                    bot = -(base + dn_arr)
                    axp.fill_between(en0[m0] - ef, -base, bot, color=col, alpha=0.4, linewidth=0)
                    axp.plot(en0[m0] - ef, bot, color=col, lw=1.0, linestyle="--")
                    export_headers.append(f"{lb}_down")
                    export_cols.append(list(-dn_arr))
                    y_bot = min(y_bot, float(bot.min()))
                base = top
            y_top = max(y_top, float(base.max()))
            axp.axvline(0, color="black", ls="--", lw=0.9)
            axp.axhline(0, color="gray", lw=0.6)
            axp.text(
                0.015, 0.93, sym, transform=axp.transAxes, fontsize=13, fontweight="bold",
                ha="left", va="top", bbox=dict(facecolor="white", edgecolor="none", alpha=0.75, boxstyle="round,pad=0.25"),
            )
            axp.legend(loc="upper right", fontsize=8, frameon=False,
                       handlelength=1.4, borderpad=0.2, labelspacing=0.25,
                       ncol=max(1, len(groups[sym]) // 4))
        # 统一 y 刻度（全图可比）
        pad_y = (y_top - y_bot) * 0.05
        for r in range(nrows):
            for c in range(ncols):
                a = axes[r][c]
                if a.get_visible():
                    a.set_ylim((y_bot - pad_y) if y_bot < 0 else 0.0, y_top + pad_y)
        # 隐藏多余子图; 最底行标 x 轴
        for gi in range(len(order), nrows * ncols):
            axes[gi // ncols][gi % ncols].set_visible(False)
        for c in range(ncols):
            axes[nrows - 1][c].set_xlabel("E - E$_F$ (eV)")
        try:
            fig.supylabel("PDOS (states/eV)", fontsize=11, x=0.015)
        except AttributeError:
            fig.text(0.015, 0.5, "PDOS (states/eV)", rotation=90, va="center", fontsize=11)
    else:
        for i, (lb, d) in enumerate(selected):
            _plot_curve(ax, d, lb, color=palette[i % len(palette)])
        ax.axvline(0, color="black", ls="--", lw=0.9)
        ax.axhline(0, color="gray", lw=0.6)
        ax.set_xlabel("E - E$_F$ (eV)")
        # 图例自动落在曲线稀疏的空白处，半透明底保证可读；两栏排布
        ax.legend(loc="best", fontsize=9, framealpha=0.75, edgecolor="0.85",
                  handlelength=1.6, borderpad=0.5, labelspacing=0.35, ncol=2)
    if not (stack and len(selected) > 1):
        ax.set_ylabel("PDOS (states/eV)")
    mode_name = {"valence": "valence shells", "element": "by element", "orbitals": "s/p/d", "fine": "fine orbitals"}[split]
    stack_note = ", stacked panels" if (stack and len(selected) > 1) else ""
    fig.suptitle(
        f"PDOS ({mode_name}{stack_note}, major contributions) — {formula}",
        fontsize=12, y=0.995,
    )

    fig.tight_layout(rect=[0, 0, 1, 0.96])
    out_png = ""
    out_txt = ""
    if save:
        stamp = int(time.time())
        out_png = os.path.join(_out_dir(project, "dos"), f"pdos_{split}_{formula}_{stamp}.png")
        fig.savefig(out_png)
        if export_cols:
            out_txt = _export_origin_txt(
                os.path.join(_out_dir(project, "dos"), f"pdos_{split}_{formula}_{stamp}"),
                ["E-EF(eV)"] + export_headers,
                export_x,
                export_cols,
            )
    plt.close(fig)

    spin_note = "自旋极化（↓ 已取负号绘制" + ("，堆叠形式" if (stack and len(selected) > 1) else "") + "）" if has_dn else "非极化（无 ↓ 数据；需要自旋分辨请在 INCAR 加 ISPIN=2 重算）"
    msg = (
        f"PDOS 图已生成: {out_png}\n"
        f"模式: {mode_name}; 保留 {len(selected)} 条主要贡献曲线"
        f"（阈值 {min_contrib:.0%}" + (f"，top {top_n}" if top_n else "") + f"）; {spin_note}; 费米能 {ef:.3f} eV\n"
        f"保留曲线: {', '.join(lb for lb, _ in selected)}"
    )
    if dropped:
        msg += "\n已忽略（贡献占比）: " + ", ".join(f"{lb} {pc:.1f}%" for lb, pc in dropped[:8])
    if out_txt:
        msg += f"\n数据文件（Origin 可直接导入）: {out_txt}"
    return msg


def OrbitalType_safe():
    """延迟导入 OrbitalType（集中维护点）。"""
    from pymatgen.electronic_structure.core import OrbitalType as _OT

    return _OT


def _elem(symbol: str):
    """Element 快捷构造（集中导入点便于维护）。"""
    from pymatgen.core import Element as _E

    return _E(symbol)


@mcp.tool()
def generate_bader_inputs(poscar_text: str, encut: Optional[int] = None, project: Optional[str] = None) -> str:
    """生成 Bader 电荷分析计算输入（LAECHG=.TRUE. 输出 AECCAR0/AECCAR2）。

    Args:
        poscar_text: POSCAR 文本。
        encut: 截断能 (eV)；缺省按体系估算。
        project: 可选项目名——产物保存到 outputs/<project>/inputs/。

    Returns:
        输入文件清单与后处理流程说明（需自备 Henkelman bader 程序）。
    """
    struct = Poscar.from_str(poscar_text).structure
    comp = struct.composition
    encut_v = encut if encut else max(500, int(max(float(Element(el.symbol).Z) for el in comp.elements) * 50))
    incar = "\n".join([
        "### Bader 电荷分析 static（MatCalcAgent 生成）###",
        f"SYSTEM = {comp.reduced_formula} bader",
        f"ENCUT = {encut_v}",
        "PREC = Accurate",
        "EDIFF = 1E-6",
        "ISMEAR = 0",
        "SIGMA = 0.05",
        "NSW = 0",
        "IBRION = -1",
        "LAECHG = .TRUE.       ! 输出 AECCAR0 / AECCAR2（Bader 必需）",
        "LCHARG = .TRUE.",
        "LWAVE = .FALSE.",
        "NGXF = 96             # 可选：加密 FFT 网格提升 Bader 精度（按体系调整）",
        "NGYF = 96",
        "NGZF = 96",
        "",
    ])
    saved = _save_input_set("bader_inputs", {"POSCAR": _to_vasp5_poscar(struct), "INCAR": incar}, project=project)
    flow = (
        "\n\n后处理流程（远程机器需安装 Henkelman group bader 程序）:\n"
        "1. VASP 跑完得到 AECCAR0 AECCAR2 CHGCAR\n"
        "2. chgsum.pl AECCAR0 AECCAR2        # 生成 CHGCAR_sum\n"
        "3. bader CHGCAR -ref CHGCAR_sum     # 生成 ACF.dat AVF.dat BvAt.dat\n"
        "4. 下载 ACF.dat 后调用 parse_bader_acf 解析各原子电荷"
    )
    return saved + flow


@mcp.tool()
def parse_bader_acf(acf_path: str, potcar_path: Optional[str] = None) -> str:
    """解析 Bader 分析输出 ACF.dat：各原子 Bader 电子数 / 最小距离 / 原子体积。

    Args:
        acf_path: 本地 ACF.dat 路径（可先用 download 拉回）。
        potcar_path: 可选 POTCAR 路径——提取 ZVAL 价电子数，计算各原子净电荷 Δq = ZVAL − n_Bader。

    Returns:
        原子电荷表与汇总。
    """
    def _resolve(p: str) -> str:
        if not os.path.isabs(p) and not os.path.exists(p):
            cand = os.path.join(_OUTPUTS_DIR, p)
            if os.path.exists(cand):
                return cand
        return p

    path = _resolve(acf_path)
    atoms = []  # (idx, charge, min_dist, vol)
    vacuum_charge = None
    total_electrons = None
    with open(path, encoding="utf-8", errors="replace") as f:
        for ln in f:
            t = ln.split()
            if len(t) >= 7 and t[0].isdigit():
                try:
                    atoms.append((int(t[0]), float(t[4]), float(t[5]), float(t[6])))
                except ValueError:
                    continue
            elif "VACUUM CHARGE" in ln:
                vacuum_charge = float(ln.split(":")[1])
            elif "NUMBER OF ELECTRONS" in ln:
                total_electrons = float(ln.split(":")[1])
    if not atoms:
        return f"错误: {path} 中未解析到原子行（确认是 bader 输出的 ACF.dat）"

    zvals: list[float] = []
    if potcar_path:
        import re as _re

        pp = _resolve(potcar_path)
        with open(pp, encoding="utf-8", errors="replace") as f:
            for ln in f:
                m_ = _re.search(r"ZVAL\s*=\s*([-\d.]+)", ln)
                if m_:
                    try:
                        zvals.append(float(m_.group(1)))
                    except ValueError:
                        continue

    rows = ["原子   Bader电子数   最小距离(Å)   原子体积(Å³)" + ("   ZVAL   净电荷Δq" if zvals else "")]
    net_all: list[float] = []
    for idx, q, dmin, vol in atoms:
        line = f"{idx:>4}   {q:>10.4f}   {dmin:>10.4f}   {vol:>10.4f}"
        if zvals and idx <= len(zvals):
            z = zvals[idx - 1]
            dq = z - q
            net_all.append(dq)
            line += f"   {z:>5.2f}   {dq:>+7.4f}"
        rows.append(line)
    summary = [
        "",
        f"共 {len(atoms)} 个原子; 总电子数: {total_electrons if total_electrons is not None else 'N/A'}"
        f"; 真空电荷: {vacuum_charge if vacuum_charge is not None else 'N/A'}",
    ]
    if net_all:
        cation = max(net_all)
        anion = min(net_all)
        summary.append(f"失电子最多: +{cation:.4f} e; 得电子最多: {anion:.4f} e（净电荷=ZVAL−n_Bader，正为失电子）")
    return "\n".join(rows + summary)


@mcp.tool()
def organize_outputs(action: str = "report", project: Optional[str] = None, pattern: str = "*") -> str:
    """整理归类 outputs 目录：盘点散落文件或按项目归类移动。

    Args:
        action: "report"=列出根目录散落文件与项目目录统计；
            "tidy"=把根目录匹配 pattern 的文件按类型移动到 outputs/<project>/ 下
            （.vasp/.cif→structures, INCAR/KPOINTS/POTCAR/.pbs/.sh→inputs,
             vasprun/OUTCAR→results, dos/pdos/bands 图与 .txt 数据→dos_pdos, .md 报告→reports）。
        project: tidy 时的目标项目名（如 "NMO_NaBattery"）。
        pattern: tidy 时的文件名通配（如 "NaCl_*"），默认 "*"。

    Returns:
        盘点报告或移动结果清单。
    """
    if action == "report":
        lines = ["== 根目录散落文件 =="]
        loose = [f for f in os.listdir(_OUTPUTS_DIR) if os.path.isfile(os.path.join(_OUTPUTS_DIR, f))]
        for f in sorted(loose):
            sz = os.path.getsize(os.path.join(_OUTPUTS_DIR, f))
            lines.append(f"  {sz / 1e6:8.2f} MB  {f}")
        if not loose:
            lines.append("  (无，根目录干净)")
        lines.append("\n== 项目目录 ==")
        for d in sorted(os.listdir(_OUTPUTS_DIR)):
            p = os.path.join(_OUTPUTS_DIR, d)
            if os.path.isdir(p):
                n_files = sum(len(fs) for _, _, fs in os.walk(p))
                lines.append(f"  {d}/  ({n_files} 文件)")
                for sub in sorted(os.listdir(p)):
                    if os.path.isdir(os.path.join(p, sub)):
                        lines.append(f"      {sub}/")
        return "\n".join(lines)

    if action == "tidy":
        import fnmatch
        import shutil

        if not project:
            return "错误: tidy 需要 project 参数（目标项目名）"
        rules = [
            (("INCAR", "KPOINTS", "POTCAR", ".pbs", ".sh"), "inputs"),
            (("vasprun", "OUTCAR", "CHGCAR", "AECCAR"), "results"),
            (("dos", "pdos", "bands"), "dos_pdos"),
            ((".vasp", ".cif"), "structures"),
            ((".md",), "reports"),
        ]

        def _classify(name: str) -> str:
            low = name.lower()
            for keys, kind in rules:
                if any(k.lower() in low or low.endswith(k) for k in keys):
                    return kind
            return ""

        moved, skipped = [], []
        for f in sorted(os.listdir(_OUTPUTS_DIR)):
            src = os.path.join(_OUTPUTS_DIR, f)
            if not os.path.isfile(src) or not fnmatch.fnmatch(f, pattern):
                continue
            kind = _classify(f)
            if not kind:
                skipped.append(f)
                continue
            dst_dir = _out_dir(project, kind)
            dst = os.path.join(dst_dir, f)
            shutil.move(src, dst)
            moved.append(f"{f} → {os.path.relpath(dst, _OUTPUTS_DIR)}")
        msg = [f"已移动 {len(moved)} 个文件到 {project}/:"]
        msg += [f"  {m}" for m in moved] or ["  (无匹配文件)"]
        if skipped:
            msg.append(f"无法识别类型（保留原位）{len(skipped)} 个: {', '.join(skipped[:6])}")
        return "\n".join(msg)

    return f"错误: action 仅支持 report|tidy，收到 '{action}'"


# ==================== M4: 作业守护 (submit_and_watch / check_job) ====================

# 节点配置（详见项目根 CLUSTERS.md；此处不含任何密码，全部 key 免密）
NODES: dict[str, dict] = {
    "master": {
        "host": "ls@10.20.119.71",
        "key": os.path.expanduser("~/.ssh/id_rsa_192_168_10_152"),
        "queue": "amd256c",
        "max_ppn": 128,
        "vasp_setup": "module load apps/vasp/5.4.4",
        "vasp_exe": "vasp_std",
        "workroot": "~/matcalc",
    },
    "hzw": {
        "host": "hzw@10.20.112.88",
        "key": None,
        "queue": "hzw",
        "max_ppn": 96,
        "vasp_setup": "source /data/intel/oneapi/setvars.sh > /dev/null 2>&1",
        "vasp_exe": "/home/hzw/software/vasp6.6/vasp.6.6.0/bin/vasp_std",
        "workroot": "~/matcalc",
    },
}

LOCAL_POTCAR_LIB = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "potcars", "potpaw_PBE")


def _ssh_base(node: str) -> list:
    """构造 ssh/scp 共用的认证参数列表。"""
    cfg = NODES[node]
    args = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=20"]
    if cfg["key"]:
        args += ["-i", cfg["key"]]
    return args


def _run_local(cmd: list, timeout: int = 120) -> tuple[int, str]:
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return r.returncode, (r.stdout or "") + (r.stderr or "")


def _make_run_pbs(node: str, job_name: str, ppn: int) -> str:
    cfg = NODES[node]
    return "\n".join([
        "#!/bin/bash",
        f"#PBS -q {cfg['queue']}",
        f"#PBS -N {job_name}",
        f"#PBS -l nodes=1:ppn={ppn}",
        "#PBS -l walltime=99:00:00",
        "#PBS -j oe",
        "",
        "cd $PBS_O_WORKDIR",
        cfg["vasp_setup"],
        f"NP=$(cat $PBS_NODEFILE | wc -l)",
        'echo "started $(date) NP=$NP"',
        f"mpirun -np $NP -machinefile $PBS_NODEFILE {cfg['vasp_exe']} > vasp.out 2>&1",
        'echo "finished $(date)"',
        "",
    ])


def _normalize_lf(path: str) -> None:
    with open(path, "rb") as f:
        data = f.read()
    data = data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
    with open(path, "wb") as f:
        f.write(data)


@mcp.tool()
def submit_and_watch(
    project: str,
    local_dir: str,
    node: str = "master",
    ppn: int = 48,
    job_name: Optional[str] = None,
    potcar_elements: Optional[str] = None,
    poll_seconds: int = 120,
    max_polls: int = 3,
) -> str:
    """一键提交 VASP 作业到集群并开始守护：输入校验→POTCAR本地拼接→LF规范→上传→qsub→轮询。

    Args:
        project: 项目名（决定远端与本地归档路径）。
        local_dir: 本地输入目录，需含 INCAR/KPOINTS/POSCAR（POTCAR 可由 potcar_elements 自动拼接）。
        node: 目标节点 "master" 或 "hzw"。
        ppn: 核数（不超过节点上限）。
        job_name: 作业名（缺省用目录名）。
        potcar_elements: 如 "Na_pv,Mn_pv,Ni_pv,O" —— 从本地 potpaw_PBE 库按 POSCAR 元素序拼接。
        poll_seconds: 守护轮询间隔秒。
        max_polls: 本次调用内轮询次数（超时后可稍后再用 check_job 查询）。

    Returns:
        提交结果与作业状态摘要。
    """
    import subprocess as sp
    import time as _time

    if node not in NODES:
        return f"错误: 未知节点 '{node}'，可选 {list(NODES)}"
    cfg = NODES[node]
    ppn = min(ppn, cfg["max_ppn"])
    local_dir = os.path.abspath(local_dir)
    if not os.path.isdir(local_dir):
        return f"错误: 目录不存在 {local_dir}"
    job_name = job_name or os.path.basename(local_dir.rstrip("/\\"))

    # 1) 输入校验 + LF 规范化
    need = ["INCAR", "KPOINTS", "POSCAR"]
    missing = [f for f in need if not os.path.isfile(os.path.join(local_dir, f))]
    if missing:
        return f"错误: 缺少输入文件 {missing}"
    for f in need:
        _normalize_lf(os.path.join(local_dir, f))

    # 2) POTCAR 本地拼接
    potcar_path = os.path.join(local_dir, "POTCAR")
    if potcar_elements and not os.path.isfile(potcar_path):
        els = [e.strip() for e in potcar_elements.split(",") if e.strip()]
        poscar_head = open(os.path.join(local_dir, "POSCAR")).read().splitlines()[5].split()
        if els != poscar_head:
            return f"错误: potcar_elements ({els}) 与 POSCAR 元素行 ({poscar_head}) 不一致"
        with open(potcar_path, "wb") as out:
            for el in els:
                seg = os.path.join(LOCAL_POTCAR_LIB, el, "POTCAR")
                if not os.path.isfile(seg):
                    os.remove(potcar_path)
                    return f"错误: 本地赝势库缺少 {el} ({seg})"
                with open(seg, "rb") as fh:
                    out.write(fh.read())
    if not os.path.isfile(potcar_path):
        return "错误: 缺少 POTCAR 且未提供 potcar_elements"

    # 3) run.pbs 生成
    pbs_path = os.path.join(local_dir, "run.pbs")
    with open(pbs_path, "w", newline="\n") as f:
        f.write(_make_run_pbs(node, job_name.replace("_", "-"), ppn))

    # 4) 上传
    remote_dir = f"{cfg['workroot']}/{project}/{job_name}"
    base_args = ["scp"] + _ssh_base(node)
    rc, out = _run_local(["ssh"] + _ssh_base(node) + [cfg["host"], f"mkdir -p {remote_dir}"])
    if rc != 0:
        return f"错误: 远端建目录失败 {out[:200]}"
    for f in need + ["POTCAR", "run.pbs"]:
        rc, out = _run_local(base_args + [os.path.join(local_dir, f), f"{cfg['host']}:{remote_dir}/{f}"])
        if rc != 0:
            return f"错误: 上传 {f} 失败 {out[:200]}"

    # 5) 提交
    rc, out = _run_local(["ssh"] + _ssh_base(node) + [cfg["host"],
                          f"cd {remote_dir} && dos2unix -q INCAR KPOINTS POSCAR run.pbs 2>/dev/null; qsub run.pbs"])
    if rc != 0 or not out.strip():
        return f"错误: qsub 失败 {out[:300]}"
    job_id = out.strip().splitlines()[-1].strip()

    # 6) 守护轮询
    status_lines = [f"已提交: {job_id} @ {node} ({project}/{job_name}, ppn={ppn})"]
    for k in range(max_polls):
        _time.sleep(poll_seconds)
        rc, out = _run_local(["ssh"] + _ssh_base(node) + [cfg["host"],
                              f"qstat -a 2>/dev/null | grep -c '{job_id.split('.')[0]}' ; tail -1 {remote_dir}/OSZICAR 2>/dev/null"])
        tail = out.strip().splitlines()
        running = tail[0].strip() if tail else "0"
        osz = tail[1].strip() if len(tail) > 1 else "(无OSZICAR)"
        done = running == "0"
        status_lines.append(f"[{(k + 1) * poll_seconds}s] {'结束' if done else '运行中'} | {osz}")
        if done:
            break
    status_lines.append(f"远端目录: {remote_dir}")
    status_lines.append("后续查询: check_job(job_id=..., node=...)")
    return "\n".join(status_lines)


@mcp.tool()
def check_job(job_id: str, node: str = "master", remote_dir: Optional[str] = None) -> str:
    """查询已提交 VASP 作业的状态、最新能量与收敛情况。

    Args:
        job_id: 作业 ID（如 "3687.master"，匹配按数字部分）。
        node: 节点名 master|hzw。
        remote_dir: 远端工作目录（缺省尝试 ~/matcalc 下自动定位失败时必须提供）。

    Returns:
        队列状态 + OSZICAR 尾行 + 收敛标记计数。
    """
    if node not in NODES:
        return f"错误: 未知节点 '{node}'"
    cfg = NODES[node]
    jnum = job_id.split(".")[0]
    rd = remote_dir or "$(find ~/matcalc -maxdepth 2 -name OUTCAR -newer /etc/hostname 2>/dev/null | head -1 | xargs dirname 2>/dev/null)"
    cmd = (f"qstat -a 2>/dev/null | grep -c '{jnum}\\.' ; "
           f"D={rd}; echo DIR=$D; "
           f"tail -1 $D/OSZICAR 2>/dev/null; "
           f"grep -c 'reached required accuracy' $D/OUTCAR 2>/dev/null")
    rc, out = _run_local(["ssh"] + _ssh_base(node) + [cfg["host"], cmd])
    return out.strip() or "(无输出)"


if __name__ == "__main__":
    mcp.run()
