"""MatCalcAgent MCP Server（M1 里程碑）。

确定性工具层（Python / pymatgen / ASE）：
- build_structure:      由化学式生成晶体结构（原型建模：rocksalt/perovskite/zincblende/
                        fluorite/bcc/fcc/hcp；或初始粗略结构；可选晶格参数与空间群校验）
- parse_poscar:         解析 POSCAR 文本，返回结构摘要
- visualize_structure:  3D 球棍图渲染（matplotlib，PNG）
- generate_vasp_inputs: VASP 输入文件生成（INCAR 按计算类型 / KPOINTS 自动网格 /
                        POTCAR 拼接脚本 + 元素与参数校验）

运行方式（stdio 传输）：
    .venv\\Scripts\\python.exe server\\main.py
"""

from __future__ import annotations

import math
import os
import subprocess
import time
from typing import Optional

import matplotlib

matplotlib.use("Agg")  # 无 GUI 环境（headless 会话）需要非交互后端
import matplotlib.pyplot as plt  # noqa: E402
from mcp.server.fastmcp import FastMCP
from pymatgen.core import Composition, Element, Structure
from pymatgen.core.lattice import Lattice
from pymatgen.io.vasp import Poscar
from pymatgen.symmetry.groups import SpaceGroup

try:  # 兼容 python server/main.py（脚本）与 from server import main（包）两种运行方式
    from . import remote  # type: ignore[no-redef]
except ImportError:  # pragma: no cover
    import remote  # type: ignore[no-redef]

mcp = FastMCP("matcalc-agent")

_OUTPUTS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "outputs")

_KIND_DIRS = {
    "structure": "structures",   # 建模/可视化
    "input": "inputs",           # 计算输入集
    "dos": "dos_pdos",           # DOS/PDOS 图与数据
    "result": "results",         # 解析产物（能带图等）
    "report": "reports",         # 报告
}


def _out_dir(project: Optional[str] = None, kind: Optional[str] = None) -> str:
    """输出目录：outputs/[<project>/][<kind>/]，自动创建。project 为空时保持根目录散放（兼容旧行为）。"""
    base = _OUTPUTS_DIR
    if project:
        base = os.path.join(base, project.strip("/\\"))
        if kind:
            base = os.path.join(base, _KIND_DIRS.get(kind, kind))
    os.makedirs(base, exist_ok=True)
    return base

